---
import Logo3DDark from "@assets/logo.3d.dark.png";
import Logo3DLight from "@assets/logo.3d.light.png";
import Logo from "@components/logo.astro";
import BaseLayout from "../layouts/baseLayout.astro";
import { ROUTES, SITE_URL } from "../constants";

const description = "Personal website of Raunaq Gupta - Design technologist with 10+ years of experience shipping enterprise web applications and developer tools.";
---

<BaseLayout
  title="Home"
  description={description}
  canonicalUrl={SITE_URL}
>
  <body>
    <Logo mode="3d" size="large" />

    <div class="content">
      <h1>Hi, I'm Raunaq</h1>
      <p>
        If you are interested in hiring me, visit my <a href={ROUTES.PORTFOLIO}
          >portfolio</a
        >. Or check out my <a href={ROUTES.BLOG}>blog</a> where I write about experiments
        in technology & design, recipes, and literature. I'm machine readable at <a
          href="/raunaq-gupta.json">raunaq-gupta.json</a
        >.
      </p>
    </div>
  </body>
</BaseLayout>

<style>
  body {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: var(--color-bg);
    color: var(--color-body-primary);
    font-family: sans-serif;
    font-size: 1.12em;
    line-height: 28px;
    max-width: 80ch;
    min-height: 100vh;
    min-height: 100dvh;
    gap: 64px;
    margin: auto;
  }

  .logo {
    width: 512px;
  }

  .logo img {
    width: 100%;
    height: 100%;
  }

  @media only screen and (max-width: 700px) {
    body {
      padding: 2em;
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }

    .logo {
      max-width: 128px;
    }
  }
</style>
