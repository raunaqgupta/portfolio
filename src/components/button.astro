---
import ArrowRightIcon from "../assets/icons/arrow-right.svg";
const { label, url, isLink, isDownload, Icon } = Astro.props;
---

{
  isLink ? (
    <a class="button" href={url} {...(isDownload ? { download: true } : {})}>
      {label}
      {Icon && <Icon />}
    </a>
  ) : (
    <button onclick={url}>
      {label}
      {Icon && <Icon />}
    </button>
  )
}

<style>
  button,
  a.button {
    text-decoration: none;
    font-size: 0.8em;
    display: inline-flex;
    flex-direction: row;
    gap: var(--space-1);
    align-items: center;
    cursor: pointer;
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-2);
    border-radius: 4px;
  }

  button:hover,
  a.button:hover {
    border-color: var(--color-highlight);
  }

  a.button:after {
    content: none;
  }
</style>
