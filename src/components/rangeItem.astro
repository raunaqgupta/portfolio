---
const { title, org, from, to } = Astro.props;
---

<section>
  <div class="heading">
    <h3>{org}</h3>
    <div>○</div>
    <div>{title}</div>
  </div>

  <time datetime={from}>{from.getFullYear()}</time> - {
    to ? <time datetime={to}>{to.getFullYear()}</time> : <span>Current</span>
  }
  <slot />
</section>

<style>
  section {
    margin-bottom: 4em;
  }

  .heading {
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-1);
  }

  h3 {
    margin: 0;
    font-weight: 600;
  }

  time,
  span {
    color: var(--color-body-secondary);
  }
</style>
