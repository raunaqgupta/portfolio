---
import { getCollection } from "astro:content";
import Grid from "../components/grid.collection.astro";
import PageLayout from "../layouts/pageLayout.astro";
import Button from "../components/button.astro";
import ArrowRightIcon from "@icons/arrow-right.svg";
import LinkedInIcon from "@icons/linkedin.svg";
import Message from "@components/message.astro";
const breadcrumbs = [{ text: "Raunaq Gupta", url: "/" }];
const products = await getCollection("articles", ({ data }) => {
  return data.category === "collection";
});
const newProducts = products.map(({ slug, ...rest }) => ({
  slug: `/collection/` + slug,
  ...rest,
}));
---

<PageLayout title="Portfolio" breadcrumbs={breadcrumbs}>
  <section id="summary">
    <p>
      I'm a design technologist with 10+ years of experience shipping enterprise
      web applications and developer tools across startups and large
      organizations.
    </p>
    <p>
      Hire me to complement your product team with expertise in modeling complex
      systems, design intuition for developer experiences, and 0→1 design &
      prototyping. Reach out at <a href="mailto:mail@raunaqgupta.com"
        >mail@raunaqgupta.com</a
      > for a chat.
    </p>
    <Message
      message="If you are a recruiter, I'd require a H-1B visa transfer to work for your organization."
    />
  </section>
  <section id="
      work-experience">
    <h2>Work Experience</h2>
    <p>
      I'm currently designing products within the Splunk's Observability suite
      at Cisco.
    </p>
    <div class="button-group">
      <Button
        label="View Resume"
        url="/resume"
        isLink={true}
        postIcon={ArrowRightIcon}
      />
      <Button
        label="LinkedIn"
        url="https://www.linkedin.com/in/raunaqgupta/"
        isLink={true}
        isExternalLink={true}
        postIcon={ArrowRightIcon}
        preIcon={LinkedInIcon}
      />
    </div>
  </section>
  <section id="case-study-collections">
    <h2>Case study collections</h2>
    <p>Read case studies grouped by organization & product engagements.</p>
    <Grid type="collection" collection={newProducts} />
  </section>
</PageLayout>

<style>
  .button-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-1);
  }
</style>
