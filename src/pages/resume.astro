---
import BaseLayout from "../layouts/baseLayout.astro";
import RangeItem from "../components/rangeItem.astro";
const jobs = await Astro.glob("../data/*.work-experience.md");
const education = await Astro.glob("../data/*.education.md");
---

<BaseLayout title="Resume">
  <section id="work-experience">
    <h2>Work experience</h2>
    {
      jobs
        .sort((a, b) => {
          return b.frontmatter.from - a.frontmatter.from;
        })
        .map((job) => (
          <RangeItem
            title={job.frontmatter.role}
            org={job.frontmatter.organization}
            from={job.frontmatter.from}
            to={job.frontmatter.to}
          >
            <job.Content />
          </RangeItem>
        ))
    }
  </section>
  <section id="education">
    <h2>Education</h2>
    {
      education
        .sort((a, b) => {
          return b.frontmatter.from - a.frontmatter.from;
        })
        .map((item) => (
          <RangeItem
            title={item.frontmatter.role}
            org={item.frontmatter.organization}
            from={item.frontmatter.from}
            to={item.frontmatter.to}
          >
            <item.Content />
          </RangeItem>
        ))
    }
  </section>
</BaseLayout>

<style>
  section {
    margin-bottom: 4em;
  }
</style>
