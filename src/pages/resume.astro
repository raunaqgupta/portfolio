---
import PageLayout from "@layouts/pageLayout.astro";
import RangeItem from "../components/rangeItem.astro";
import CaseStudySmall from "../components/caseStudy.small.astro";
import DownloadIcon from "@icons/download.svg";
import LinkedInIcon from "@icons/linkedin.svg";

import { getCollection } from "astro:content";
import { getEntries } from "astro:content";
import { ROUTES, SITE_URL } from "../constants";

let rawJobs = [];
let education = [];

try {
  rawJobs = await getCollection("jobs");
  education = await getCollection("education");
} catch (error) {
  console.error("Error fetching resume data:", error);
}

const jobs = await Promise.all(
  rawJobs.map(async (job) => {
    try {
      const rendered = await job.render();
      const caseStudies = job.data.caseStudies
        ? await getEntries(job.data.caseStudies)
        : [];
      return { ...job, Content: rendered.Content, caseStudies };
    } catch (error) {
      console.error(`Error rendering job ${job.slug}:`, error);
      return { ...job, Content: null, caseStudies: [] };
    }
  })
);
const sortedJobs = [...jobs].sort(
  (a, b) => b.data.from.getTime() - a.data.from.getTime()
);

const sortedEducation = [...education].sort(
  (a, b) => b.data.from.getTime() - a.data.from.getTime()
);

const breadcrumbs = [
  { text: "Raunaq Gupta", url: ROUTES.HOME },
  { text: "Portfolio", url: ROUTES.PORTFOLIO },
];

const actions = [
  {
    label: "LinkedIn",
    url: "https://www.linkedin.com/in/raunaqgupta/",
    isResponsive: true,
    isLink: true,
    isExternalLink: true,
    preIcon: LinkedInIcon,
  },
  {
    label: "Download",
    url: "/resume.raunaqgupta.pdf",
    isResponsive: true,
    isLink: true,
    isDownload: true,
    preIcon: DownloadIcon,
  },
];
---

<PageLayout
  title="Resume"
  description="Resume and work experience of Raunaq Gupta"
  canonicalUrl={`${SITE_URL}${ROUTES.RESUME}`}
  breadcrumbs={breadcrumbs}
  actions={actions}
>
  <section>
    <div class="heading">
      <h2>Experience</h2>
    </div>
    {
      sortedJobs.map((job) => (
        <RangeItem
          title={job.data.role}
          org={job.data.organization}
          from={job.data.from}
          to={job.data.to}
        >
          {job.Content && <job.Content />}
        </RangeItem>
      ))
    }
  </section>
  <section>
    <div class="heading">
      <h2>Education</h2>
    </div>
    {
      sortedEducation.map((item) => (
        <RangeItem
          title={item.data.role}
          org={item.data.organization}
          from={item.data.from}
          to={item.data.to}
        />
      ))
    }
  </section>
</PageLayout>

<style>
  .heading {
    display: grid;
    grid-template-columns: 120px 1fr;
    column-gap: var(--space-2);
  }

  .heading h2 {
    grid-column: 1;
    color: var(--color-heading);
    font-size: 1em;
    font-weight: 200;
    font-style: italic;
    margin-top: 2em;
  }

  .projects {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: row;
    gap: var(--space-2);
    margin-bottom: 2em;
  }

  @media only screen and (max-width: 700px) {
    .projects {
      flex-direction: column;
    }

    h2 {
      grid-column: 1;
      margin-top: 2em;
    }

    button,
    a.button {
      padding: var(--space-1);
    }

    .post-icon {
      display: none;
    }

    .label {
      display: none;
    }
  }
</style>
