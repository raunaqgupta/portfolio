---
const { title, links } = Astro.props;
import Breadcrumbs from "../components/breadcrumbs.astro";
import MetaTags from "../components/metaTags.astro";
import Footer from "../components/footer.astro";
---

<html lang="en">
  <head>
    <title>Raunaq Gupta / {title}</title>
    <MetaTags />
  </head>
  <body>
    <header>
      <Breadcrumbs links={links} />
      <h1>{title}</h1>
    </header>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --space-0: 4px;
    --space-1: 8px;
    --space-2: 16px;
    --space-3: 24px;
    --color-bg: #f6f6f6;
    --color-text: #111;
  }

  @font-face {
    font-family: "DMSerifDisplay";
    src: local("DMSerifDisplay"), url("/fonts/DMSerifDisplay-Italic.ttf");
    font-display: swap;
  }

  html {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: -webkit-fill-available;
  }

  body {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 4em 8em 0;
    font-size: 18px;
    line-height: 28px;
    font-family: sans-serif;
    max-width: 69ch;
    background-color: var(--color-bg);
    color: #111;
    flex-grow: 1;
  }

  main {
    flex-grow: 1;
  }

  h1 {
    margin: 0;
    font-weight: 200;
    line-height: 1.12em;
    font-family: "DMSerifDisplay";
  }

  h2 {
    margin-top: 2em;
    font-weight: 200;
    font-size: 1.2em;
    color: #333;
  }

  h3 {
    margin-bottom: 0;
  }

  figure {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    width: 100%;
  }

  figure > img {
    padding-bottom: 8px;
    border-bottom: 1px solid #d8d8d8;
  }

  figcaption {
    font-size: 14px;
    color: #666;
    padding: 4px 0px;
  }

  img {
    width: 100%;
  }

  time {
    color: #666;
  }

  ol {
    padding-inline-start: 1.5em;
  }

  ul {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    padding-inline-start: 0;
    gap: 8px;
  }

  ul.styled {
    list-style-type: disc;
    padding-inline-start: 1em;
  }

  a {
    display: inline;
    text-decoration: none;
    padding-bottom: 1px;
    box-sizing: border-box;
    color: rgb(0, 0, 0);
    position: relative;
    text-decoration-line: underline;
    text-decoration-style: solid;
    text-underline-offset: 5px;
    text-decoration-color: #ccc;
    text-decoration-skip-ink: auto;
    transition: text-decoration-color 0.5s ease-out;
  }

  a:after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    border-bottom: 2px solid #00659b;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease-out;
  }

  a:hover::after,
  a:focus::after {
    transform: scaleX(1);
  }

  a:hover,
  a:focus {
    text-decoration: none;
  }

  a.muted {
    color: #999;
    border-bottom-color: transparent;
  }

  a.muted:hover {
    border-bottom-width: 0;
  }

  @media only screen and (max-width: 1024px) {
    body {
      padding: 4e 4em 0;
    }
  }

  @media only screen and (max-width: 700px) {
    body {
      padding: 2em 1.5em 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a::after {
      transition: none;
    }
  }
</style>
