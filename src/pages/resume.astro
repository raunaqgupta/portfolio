---
import BaseLayout from "../layouts/baseLayout.astro";
import RangeItem from "../components/rangeItem.astro";
const jobs = await Astro.glob("../data/*.work-experience.md");
---

<BaseLayout title="Resume">
  <section id="work-experience">
    <h2>Work Experience</h2>
    {
      jobs
        .sort((a, b) => {
          return b.frontmatter.from - a.frontmatter.from;
        })
        .map((job) => (
          <RangeItem
            title={job.frontmatter.role}
            org={job.frontmatter.organization}
            from={job.frontmatter.from}
            to={job.frontmatter.to}
          >
            <job.Content />
          </RangeItem>
        ))
    }
  </section>
  <section id="education">
    <h2>Education</h2>
    <RangeItem
      title="Master of Human-Computer Interaction from Carnegie Mellon University"
      from="2012"
      to="2013"
    />
    <RangeItem
      title="Bachelors of Technology in Computer Science from Amity University"
      from="2005"
      to="2009"
    />
  </section>
  <section id="notes">
    <h2>Notes</h2>
    <section>
      <h3>Work authorization</h3>
      <p>H-1B Visa, USA</p>
      <p>Citizen, India</p>
    </section>
  </section>
</BaseLayout>

<style>
  section {
    margin-bottom: 4em;
  }
</style>
