---
import Toolbar from "@components/toolbar.astro";
import WideLayout from "@layouts/WideLayout.astro";
import Olmdx from "@components/Ol.mdx.astro";
import Input from "@components/input.astro";
import { getCollection } from "astro:content";
import { ROUTES, SITE_URL } from "../constants";
import { formatDate } from "../utils";

let blog = [];
try {
  blog = await getCollection("articles", ({ data }) => {
    return data.internal !== true && data.category !== "portfolio";
  });
} catch (error) {
  console.error("Error fetching blog posts:", error);
}

const newBlog = blog
  .map(({ id, ...rest }) => ({
    id: `${ROUTES.BLOG}/` + id,
    ...rest,
  }))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<WideLayout
  title="Blog"
  description="Blog posts about experiments in technology & design, recipes, and literature"
  canonicalUrl={`${SITE_URL}${ROUTES.BLOG}`}
>
  <Toolbar>
    <Input id="blog-search-input" name="search" placeholder="Search" />
  </Toolbar>
  <div id="blog-list">
    <Olmdx>
      {
        newBlog.map((item) => (
          <li data-category={item.data.category || ""}>
            <div class="date">{formatDate(item.data.date)}</div>
            <span>
              <a href={item.id}>{item.data.title}</a>
            </span>
          </li>
        ))
      }
    </Olmdx>
  </div>
</WideLayout>

<script type="module">
  const input = document.getElementById("blog-search-input");
  const list = document.querySelector("#blog-list ul");

  if (input && list) {
    const items = Array.from(list.querySelectorAll("li"));

    const filterItems = () => {
      const searchValue = input.value.trim().toLowerCase();

      items.forEach((item) => {
        const text = item.textContent?.toLowerCase() ?? "";
        const matchesSearch = !searchValue || text.includes(searchValue);
        item.hidden = !matchesSearch;
      });
    };

    input.addEventListener("input", filterItems);
  }
</script>

<style>
  li {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  li a {
    display: inline;
  }

  li .date,
  li .category {
    display: flex;
    align-items: center;
    gap: var(--space-0);
    color: var(--color-body-tertiary);
    text-transform: capitalize;
  }

  @media (max-width: 768px) {
    li {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: var(--space-0);
    }

    li .date {
      font-size: var(--typography-body-small);
      margin-bottom: var(--space-1);
    }
  }
</style>
