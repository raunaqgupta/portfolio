---
import { Recipe } from "cooklang";
const { recipe } = Astro.props;
const newRecipe = new Recipe(recipe);
---

<div class="meta">
  {
    newRecipe.metadata.map((metadatum) => (
      <div class="property">
        <div class="key">{metadatum.key}</div>{" "}
        <div class="value">{metadatum.value}</div>
      </div>
    ))
  }
</div>

<h2>Ingredients</h2>

<ul class="ingredients">
  {
    newRecipe.ingredients.map((ingredient) => (
      <li class="ingredient">
        <span class="amount">{ingredient.amount}</span>
        <span class="units">{ingredient.units}</span>
        <span class="name">{ingredient.name}</span>
      </li>
    ))
  }
</ul>

<h2>Instructions</h2>

<ul class="instructions">
  {
    newRecipe.steps.map((step) => (
      <li>
        {step.line.map((token) =>
          typeof token === "string" ? (
            <span>{token}</span>
          ) : (
            <span>{token.name}</span>
          )
        )}
      </li>
    ))
  }
</ul>

<style>
  .meta {
    display: flex;
    flex-direction: row;
    list-style: none;
    padding: 0;
    gap: var(--space-4);
  }

  .meta .property {
    display: flex;
    flex-direction: column;
  }

  .meta .property .key {
    font-size: var(--typography-body-small);
    color: var(--color-body-tertiary);
  }

  .property {
    text-transform: capitalize;
  }

  .ingredients {
    list-style-type: none;
    padding: 0;
  }

  .instructions {
    list-style: decimal;
    padding-inline-start: 24px;
  }
</style>
