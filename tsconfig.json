{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "paths": {
      "@layouts/*": ["./src/layouts/*"],
      "@components/*": ["./src/components/*"],
      "@icons/*": ["./src/assets/icons/*"],
      "@assets/*": ["./src/assets/*"],
      "@src/*": ["./src/*"],
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
  },
  "include": ["src/**/*"],
}
