---
import BaseLayout from "../../layouts/baseLayout.astro";
import Imgmdx from "../../components/img.mdx.astro";

import { getCollection } from "astro:content";
import Toolbar from "../../components/toolbar.astro";
export async function getStaticPaths() {
  const poems = await getCollection("poems");
  return poems.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, components } = await entry.render();
const links = [
  { text: "Raunaq Gupta", url: "/" },
  { text: "Poems", url: "/poems" },
];

const format = { year: "numeric", month: "long", day: "numeric" };
---

<BaseLayout title={entry.data.title} links={links}>
  <Content components={{ ...components, img: Imgmdx }} />
  <Toolbar>{entry.data.date.toLocaleDateString("en-US", format)}</Toolbar>
</BaseLayout>
