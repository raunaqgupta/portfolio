---
const { title, links } = Astro.props;
import Breadcrumbs from "../components/breadcrumbs.astro";
import MetaTags from "../components/metaTags.astro";
import Footer from "../components/footer.astro";
---

<html lang="en">
  <head>
    <title>Raunaq Gupta / {title}</title>
    <MetaTags />
  </head>
  <body>
    <header>
      <Breadcrumbs links={links} />
      <h1>{title}</h1>
    </header>
    <div class="content">
      <slot />
    </div>
    <Footer />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Urbanist";
    src: local("Urbanist"), url("/fonts/Urbanist-VariableFont_wght.ttf");
    font-display: swap;
  }

  @font-face {
    font-family: "DMSerifDisplay";
    src: local("DMSerifDisplay"), url("/fonts/DMSerifDisplay-Italic.ttf");
    font-display: swap;
  }

  html {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: -webkit-fill-available;
  }

  body {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 4em 8em 0;
    font-size: 18px;
    line-height: 28px;
    font-family: "Manrope", sans-serif;
    max-width: 69ch;
    background-color: #f6f6f6;
    color: #333;
    flex-grow: 1;
  }

  .content {
    flex-grow: 1;
  }

  h1 {
    margin: 0;
    font-weight: 200;
    line-height: 1.12em;
    font-family: "DMSerifDisplay";
  }

  h2 {
    margin-top: 2em;
    font-weight: 200;
    font-size: 1.2em;
  }

  h3 {
    margin-bottom: 0;
  }

  figure {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    width: 100%;
    border: 1px solid #eaeaea;
    border-radius: 6px;
  }

  figcaption {
    border-top: 1px solid #eaeaea;
    font-size: 14px;
    color: #666;
    padding: 4px 16px;
  }

  img {
    width: 100%;
  }

  time {
    color: #666;
  }

  ul {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    padding-inline-start: 0;
    gap: 8px;
  }

  a {
    display: inline;
    text-decoration: none;
    padding-bottom: 2px;
    box-sizing: border-box;
    border-bottom: 1px solid #ccc;
    color: rgb(0, 0, 0);
  }

  a.muted {
    color: #999;
    border-bottom-color: transparent;
  }

  a:hover {
    border-bottom-width: 2px;
    border-bottom-color: #000;
    transition: border -bottom-width ease-out 100ms,
      border-bottom-color ease-in 50ms;
  }

  a.muted:hover {
    border-bottom-width: 0;
  }

  @media only screen and (max-width: 1024px) {
    body {
      padding: 4e 4em 0;
    }
  }

  @media only screen and (max-width: 700px) {
    body {
      padding: 2em 1.5em 0;
    }
  }
</style>
