---
const { size = "small" } = Astro.props;
import Logo from "../assets/logo.svg";
---

<div class="logo-container">
  <a class="logo-link" href="/"><Logo class:list={[size]} /></a>
</div>

<style>
  .logo-container {
    display: flex;
    align-items: center;
  }

  .logo-container .logo-link {
    display: inline-flex;
    text-decoration: none;
  }

  .logo-container .logo-link:after {
    content: none;
  }

  .small {
    height: 42px;
    width: 42px;
  }

  .large {
    height: 128px;
    width: 128px;
  }
</style>
