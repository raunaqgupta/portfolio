---
import WideLayout from "@layouts/WideLayout.astro";
import ResumeBody from "@components/resumeBody.astro";
import DownloadIcon from "@icons/download.svg";
import LinkedInIcon from "@icons/linkedin.svg";
import { ROUTES, SITE_URL } from "../constants";

const actions = [
  {
    label: "LinkedIn",
    url: "https://www.linkedin.com/in/raunaqgupta/",
    isResponsive: true,
    isLink: true,
    isExternalLink: true,
    preIcon: LinkedInIcon,
  },
  {
    label: "Download",
    url: "/resume.raunaqgupta.pdf",
    isResponsive: true,
    isLink: true,
    isDownload: true,
    preIcon: DownloadIcon,
  },
];
---

<WideLayout
  title="Resume"
  description="Resume and work experience of Raunaq Gupta"
  canonicalUrl={`${SITE_URL}${ROUTES.RESUME}`}
  actions={actions}
>
  <ResumeBody />
</WideLayout>

<style>
  .projects {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: row;
    gap: var(--space-2);
    margin-bottom: 2em;
  }

  @media only screen and (max-width: 700px) {
    .projects {
      flex-direction: column;
    }

    h2 {
      grid-column: 1;
      margin-top: 2em;
    }

    button,
    a.button {
      padding: var(--space-1);
    }

    .post-icon {
      display: none;
    }

    .label {
      display: none;
    }
  }
</style>
