---
const props = Astro.props;
---

<ul {...props} class="custom-ul">
  <slot />
</ul>

<style>
  .custom-ul {
    list-style-type: disc;
    padding-inline-start: 1em;
    margin: 0.5rem 0;
    font-size: var(--typography-body);
  }
  .custom-ul li {
    color: orange;
    margin: 0.25rem 0;
  }
</style>
