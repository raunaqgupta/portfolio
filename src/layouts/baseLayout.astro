---
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personal website of Raunaq Gupta" />
    <meta http-equiv="content-type" content="text/html;charset=utf-8" />
  </head>
  <body>
    <header>
      <nav><div><a href="/">Raunaq Gupta</a> /</div></nav>
      <h1>{title}</h1>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Urbanist";
    src: local("Urbanist"), url("/fonts/Urbanist-VariableFont_wght.ttf");
    font-display: swap;
  }

  body {
    margin: 0;
    padding: 4em;
    font-size: 18px;
    line-height: 28px;
    font-family: "Manrope", sans-serif;
    max-width: 69ch;
    background-color: #f6f6f6;
    color: #333;
  }

  h1 {
    margin-top: 0.5em;
    font-weight: 200;
  }

  h2 {
    margin-top: 2em;
    font-weight: 200;
  }

  ul {
    list-style-type: none;
    padding-inline-start: 0;
    gap: 8px;
  }

  a {
    display: inline;
    box-sizing: border-box;
    text-decoration: none;
    color: rgb(78, 78, 185);
  }

  a.subtle {
    display: inline;
    box-sizing: border-box;
    border-bottom: 1px solid;
    color: rgb(0, 0, 0);
  }

  a:hover {
    border-bottom: 2px solid;
    transition: border-bottom ease 100ms;
  }

  @media only screen and (max-width: 700px) {
    body {
      padding: 2em;
    }
  }
</style>
