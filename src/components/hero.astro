---
interface Props {
  imageUrl?: string;
}

const { imageUrl } = Astro.props;
---

<div class="hero">
  <div style={`--img: url("${imageUrl}")`}></div>
</div>

<style>
  .hero {
    width: 100%;
    aspect-ratio: 3;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--color-border-bg);
  }

  .hero > div {
    width: 100%;
    height: 100%;
    background-image: var(--img);
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
  }
</style>
