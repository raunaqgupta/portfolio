---
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personal website of Raunaq Gupta" />
  </head>
  <body>
    <header>
      <nav><div><a href="/">Raunaq Gupta</a> /</div></nav>
      <h1>{title}</h1>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Manrope";
    src: local("Manrope"), url("/fonts/Manrope-Regular.woff2");
    font-display: swap;
  }

  @font-face {
    font-family: "Manrope";
    font-weight: bold;
    src: local("Manrope"), url("/fonts/Manrope-Bold.woff2");
    font-display: swap;
  }

  body {
    margin: 0;
    padding: 4em;
    font-size: 16px;
    font-family: "Manrope", sans-serif;
    max-width: 69ch;
  }

  h1 {
    margin-top: 0;
  }

  ul {
    list-style-type: circle;
    padding-inline-start: 1.25em;
  }

  @media only screen and (max-width: 700px) {
    body {
      padding: 2em;
    }
  }
</style>
