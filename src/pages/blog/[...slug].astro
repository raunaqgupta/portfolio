---
import PageLayout from "@layouts/pageLayout.astro";
import Imgmdx from "@components/img.mdx.astro";

import { getCollection } from "astro:content";
import PostDetails from "@components/PostDetails.astro";
import { formatDate } from "../../utils";
import { ROUTES, SITE_URL } from "../../constants";
import { getDescription } from "../../utils";

export async function getStaticPaths() {
  try {
    const blog = await getCollection("articles", ({ data }) => {
      return data.internal !== true && data.category !== "case-study";
    });
    return blog.map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
  } catch (error) {
    console.error("Error generating blog paths:", error);
    return [];
  }
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect("/404");
}

const { Content, components } = await entry.render();
const links = [
  { text: "Raunaq Gupta", url: ROUTES.HOME },
  { text: "Blog", url: ROUTES.BLOG },
];

const description = entry.data.description || getDescription(undefined, entry.body);
const canonicalUrl = `${SITE_URL}${ROUTES.BLOG}/${entry.slug}`;
const publishedTime = entry.data.date.toISOString();
---

<PageLayout
  title={entry.data.title}
  description={description}
  type="article"
  publishedTime={publishedTime}
  canonicalUrl={canonicalUrl}
  breadcrumbs={links}
  frontmatter={entry.data}
>
  <Content components={{ ...components, img: Imgmdx }} />
  <PostDetails>
    <div class="date">
      {formatDate(entry.data.date)}
    </div>
    <div class="separator">-</div>
    <div class="category">
      {entry.data.category}
    </div>
  </PostDetails>
</PageLayout>

<style>
  .date,
  .separator,
  .category {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .category {
    text-transform: capitalize;
  }
</style>
