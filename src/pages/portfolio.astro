---
import { getCollection } from "astro:content";
import Grid from "../components/grid.collection.astro";
import PageLayout from "../layouts/pageLayout.astro";
import Message from "@components/message.astro";
import { ROUTES, SITE_URL } from "../constants";

let caseStudies = [];
try {
  caseStudies = await getCollection("articles", ({ data }) => {
    return data.category === "case-study";
  });
} catch (error) {
  console.error("Error fetching case studies:", error);
}

const newProducts = caseStudies.map(({ slug, ...rest }) => ({
  slug: `/case-study/` + slug,
  ...rest,
}));
---

<PageLayout
  title="Portfolio"
  description="Design technologist with 10+ years of experience shipping enterprise web applications and developer tools"
  canonicalUrl={`${SITE_URL}${ROUTES.PORTFOLIO}`}
>
  <section id="summary">
    <p>
      I'm a design technologist with 10+ years of experience shipping enterprise
      web applications and developer tools across startups and large
      organizations.
    </p>
    <Message
      message="I currently require a H-1B visa transfer to work for US-based organizations."
    />
  </section>
  <section id="case-studies">
    <h2>Case studies</h2>
    <Grid collection={newProducts} />
  </section>
</PageLayout>

<style>
  .button-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-1);
  }
</style>
