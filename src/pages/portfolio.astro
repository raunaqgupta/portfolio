---
import { getCollection } from "astro:content";
import List from "../components/list.astro";
import BaseLayout from "../layouts/baseLayout.astro";
const breadcrumbs = [{ text: "Raunaq Gupta", url: "/" }];
const caseStudies = await getCollection("casestudies", ({ data }) => {
  return data.caseStudy === true;
});
const newCaseStudies = caseStudies.map(({ slug, ...rest }) => ({
  slug: `/casestudies/` + slug,
  ...rest,
}));
console.log(caseStudies);
---

<BaseLayout title="Portfolio" breadcrumbs={breadcrumbs}>
  <section id="summary">
    <p>
      I'm a design technologist with 10+ experience shipping enterprise web
      applications and developer tools across startups and large organizations.
      I complement product teams with expertise in systems design, an intuition
      for designing for developers and simplifying complex enterprise workflows.
    </p>
    <p>
      Hire me to complement your product team with an expert in modeling complex
      systems, and 0→1 design & prototyping. Reach out at <a
        href="mailto:mail@raunaqgupta.com">mail@raunaqgupta.com</a
      > for full-time, and fractional roles.
    </p>
  </section>
  <section id="resume">
    <h2>Resume</h2>
    <p>
      I'm currently designing various Splunk Observability products at Cisco.
      View my resume <a href="/resume">here</a>. Download it <a
        href="/resume.raunaqgupta.pdf"
        download>here</a
      >.
    </p>
  </section>
  <section id="case-studies">
    <h2>Case studies</h2>
    <List collection={newCaseStudies} />
  </section>
  <section id="gallery">
    <h2>Gallery</h2>
    <p>TODO</p>
  </section>
</BaseLayout>
