---
import Signature from "../assets/signature.svg";

const { size = "small" } = Astro.props;
---

<div class="logo-container">
  <a class="no-decoration no-hover logo-link" href="/" aria-label="Raunaq Gupta">
    <Signature class:list={["signature", size]} aria-hidden="true" />
  </a>
</div>

<style>
  .logo-container {
    display: flex;
    align-items: center;
  }

  .logo-container .logo-link {
    display: inline-flex;
    text-decoration: none;
    color: var(--color-heading);
  }

  .logo-container .logo-link:after {
    content: none;
  }

  /* The signature is 1020 × 390; sizes keep that aspect ratio. */
  .signature {
    display: block;
    aspect-ratio: 1020 / 390;
    height: auto;
  }

  .small {
    width: 96px;
  }

  .large {
    width: 240px;
  }
</style>
