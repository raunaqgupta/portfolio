---
import WideLayout from "@layouts/WideLayout.astro";
import Prose from "@components/Prose.astro";
import Imgmdx from "@components/img.mdx.astro";
import Ulmdx from "@components/ul.mdx.astro";
import Listmdx from "@components/list.mdx.astro";
import Codemdx from "@components/Code.mdx.astro";
import Hero from "@components/hero.astro";

import { getCollection } from "astro:content";
import { SITE_URL } from "../../constants";
import { getDescription } from "../../utils";

export async function getStaticPaths() {
  try {
    const projects = await getCollection("articles", ({ data }) => {
      return data.category === "portfolio";
    });
    return projects.map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
  } catch (error) {
    console.error("Error generating case study paths:", error);
    return [];
  }
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect("/404");
}

const { Content } = await entry.render();

const description =
  entry.data.description || getDescription(undefined, entry.body);
const canonicalUrl = `${SITE_URL}/portfolio/${entry.slug}`;
---

<WideLayout
  title={entry.data.title}
  description={description}
  image={entry.data.hero || entry.data.thumbnail}
  type="article"
  canonicalUrl={canonicalUrl}
  frontmatter={entry.data}
>
  <Hero imageUrl={entry.data.hero} />
  <Prose>
    <Content components={{ img: Imgmdx, ul: Ulmdx, code: Codemdx }} />
  </Prose>
</WideLayout>
