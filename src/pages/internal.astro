---
import Toolbar from "@components/toolbar.astro";
import PageLayout from "../layouts/pageLayout.astro";
import Olmdx from "@components/Ol.mdx.astro";
import Input from "@components/input.astro";
import { getCollection } from "astro:content";
import { ROUTES } from "../constants";
import { formatDate } from "../utils";

let blog = [];
try {
  blog = await getCollection("articles", ({ data }) => {
    return data.internal === true;
  });
} catch (error) {
  console.error("Error fetching internal posts:", error);
}

const newBlog = blog
  .map(({ slug, ...rest }) => ({
    slug: `${ROUTES.INTERNAL}/` + slug,
    ...rest,
  }))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categories = [
  ...new Set(newBlog.map((item) => item.data.category).filter(Boolean)),
].sort();
---

<PageLayout title="Internal" robots="noindex, nofollow">
  <Toolbar>
    <Input id="blog-search-input" name="search" placeholder="Search" />
  </Toolbar>
  <div id="blog-list">
    <Olmdx>
      {
        newBlog.map((item) => (
          <li data-category={item.data.category || ""}>
            <a href={item.slug}>{item.data.title}</a>{" "}
            <div class="meta">
              <div class="date">{formatDate(item.data.date)}</div>
              <div class="separator">○</div>
              <div class="category"> {item.data.category} </div>
            </div>
          </li>
        ))
      }
    </Olmdx>
  </div>
</PageLayout>

<script type="module">
  const input = document.getElementById("blog-search-input");
  const list = document.querySelector("#blog-list ul");

  if (input && list) {
    const items = Array.from(list.querySelectorAll("li"));

    const filterItems = () => {
      const searchValue = input.value.trim().toLowerCase();

      items.forEach((item) => {
        const text = item.textContent?.toLowerCase() ?? "";
        const matchesSearch = !searchValue || text.includes(searchValue);
        item.hidden = !matchesSearch;
      });
    };

    input.addEventListener("input", filterItems);
  }
</script>

<style>
  li .meta {
    display: flex;
    gap: var(--space-0);
    font-size: 0.5em;
    color: var(--color-body-tertiary);
  }

  li .meta .category {
    text-transform: capitalize;
  }
</style>
