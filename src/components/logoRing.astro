---
import Logo from "@components/logo.astro";
import { ROUTES } from "../constants";
import { labelOffset, layoutRing } from "./logoRing.layout";

const { current } = Astro.props;

const links = [
  { label: "Home", href: ROUTES.HOME },
  { label: "Portfolio", href: ROUTES.PORTFOLIO },
  { label: "Resume", href: ROUTES.RESUME },
  { label: "Blog", href: ROUTES.BLOG },
];

// Must match the CSS below and --space-1/--space-2 in baseLayout. These estimates give
// the first render; the script measures the real text and redoes the layout.
const FONT_SIZE = 16;
const DOT = 4;
const GAP = 8;
const LOGO_GAP = 16;
// The signature artwork is 1020 × 390.
const LOGO_WIDTH = 200;
const LOGO_HEIGHT = (LOGO_WIDTH * 390) / 1020;
const CAP_HEIGHT = 0.72 * FONT_SIZE;
const labelWidths = links.map(({ label }) => label.length * 0.68 * FONT_SIZE);

const layout = layoutRing({
  labelWidths,
  dot: DOT,
  gap: GAP,
  logoGap: LOGO_GAP,
  textHeight: CAP_HEIGHT,
  logoWidth: LOGO_WIDTH,
  logoHeight: LOGO_HEIGHT,
});
const dots = layout.dotPositions.map(layout.pointAt);
---

<div
  class="logo-ring"
  style={`--ring-width: ${layout.width}px; --ring-ratio: ${layout.width} / ${layout.height}; --logo-width: ${(layout.logoWidth / layout.width) * 100}%;`}
  data-logo-width={LOGO_WIDTH}
  data-logo-height={LOGO_HEIGHT}
>
  <Logo size="ring" />
  <nav class="ring" aria-label="Site">
    <svg viewBox={`0 0 ${layout.width} ${layout.height}`} data-dot={DOT}>
      <defs>
        <path id="logo-ring-path" d={layout.path} />
      </defs>
      {
        dots.map(({ x, y }) => (
          <circle class="separator" cx={x} cy={y} r={DOT / 2} />
        ))
      }
      {
        links.map(({ label, href }, i) => (
          <a href={href} aria-current={current === href ? "page" : undefined}>
            <text dy={CAP_HEIGHT / 2}>
              <textPath
                href="#logo-ring-path"
                startOffset={labelOffset(
                  layout.labelPositions[i],
                  layout.perimeter,
                )}
                textLength={labelWidths[i]}
                lengthAdjust="spacing"
              >
                {label}
              </textPath>
            </text>
          </a>
        ))
      }
    </svg>
  </nav>
  <span class="measure" aria-hidden="true"></span>
</div>

<script>
  import { labelOffset, layoutRing, type RingLayout } from "./logoRing.layout";

  // One lap every 20 seconds, as the circle used to spin.
  const LAP_SECONDS = 20;

  const motion = matchMedia(
    "(prefers-reduced-motion: no-preference) and (min-width: 701px)",
  );

  interface Ring {
    root: HTMLElement;
    layout?: RingLayout;
    /** Distance the labels have travelled along the path. */
    shift: number;
    paused: boolean;
  }

  function fit(ring: Ring) {
    const { root } = ring;
    const svg = root.querySelector<SVGSVGElement>(".ring svg")!;
    const texts = [...svg.querySelectorAll<SVGTextElement>("text")];
    const textPaths = [...svg.querySelectorAll("textPath")];
    const measure = root.querySelector<HTMLElement>(".measure")!;
    const style = getComputedStyle(measure);
    const rootStyle = getComputedStyle(root);
    const gap = parseFloat(rootStyle.getPropertyValue("--gap"));
    const logoGap = parseFloat(rootStyle.getPropertyValue("--logo-gap"));

    // Measure each label as HTML text: SVG text measurement differs between
    // browsers, HTML layout does not.
    const labelWidths = textPaths.map((textPath) => {
      measure.textContent = textPath.textContent;
      return measure.getBoundingClientRect().width;
    });

    // Cap height of the label font, so the signature can sit logoGap inside it.
    const ctx = document.createElement("canvas").getContext("2d")!;
    ctx.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
    const textHeight = ctx.measureText("H").actualBoundingBoxAscent;

    const layout = layoutRing({
      labelWidths,
      dot: Number(svg.dataset.dot),
      gap,
      logoGap,
      textHeight,
      logoWidth: Number(root.dataset.logoWidth),
      logoHeight: Number(root.dataset.logoHeight),
    });
    ring.layout = layout;

    root.style.setProperty("--ring-width", `${layout.width}px`);
    root.style.setProperty("--ring-ratio", `${layout.width} / ${layout.height}`);
    root.style.setProperty(
      "--logo-width",
      `${(layout.logoWidth / layout.width) * 100}%`,
    );
    svg.setAttribute("viewBox", `0 0 ${layout.width} ${layout.height}`);
    // Centre the capitals on the path rather than sitting on it.
    texts.forEach((t) => t.setAttribute("dy", String(textHeight / 2)));
    svg.querySelector("path")!.setAttribute("d", layout.path);
    // textLength makes each label render at exactly its slot width, so the
    // labels can never run into the dots whatever the font.
    textPaths.forEach((textPath, i) => {
      textPath.setAttribute("textLength", String(labelWidths[i]));
    });
    place(ring);
  }

  // Move the labels and dots `shift` px along the ellipse.
  function place({ root, layout, shift }: Ring) {
    if (!layout) return;
    const svg = root.querySelector<SVGSVGElement>(".ring svg")!;
    svg.querySelectorAll("textPath").forEach((textPath, i) => {
      const s = layout.labelPositions[i] + shift;
      textPath.setAttribute("startOffset", String(labelOffset(s, layout.perimeter)));
    });
    svg.querySelectorAll("circle").forEach((circle, i) => {
      const { x, y } = layout.pointAt(layout.dotPositions[i] + shift);
      circle.setAttribute("cx", String(x));
      circle.setAttribute("cy", String(y));
    });
  }

  const rings: Ring[] = [
    ...document.querySelectorAll<HTMLElement>(".logo-ring"),
  ].map((root) => {
    const ring: Ring = { root, shift: 0, paused: false };
    const pause = () => (ring.paused = true);
    const resume = () => (ring.paused = root.matches(":hover, :focus-within"));
    root.addEventListener("pointerenter", pause);
    root.addEventListener("pointerleave", resume);
    root.addEventListener("focusin", pause);
    root.addEventListener("focusout", () => requestAnimationFrame(resume));
    return ring;
  });

  rings.forEach(fit);
  document.fonts.ready.then(() => rings.forEach(fit));

  let last: number | undefined;
  function tick(now: number) {
    const dt = last === undefined ? 0 : (now - last) / 1000;
    last = now;
    if (motion.matches) {
      rings.forEach((ring) => {
        if (ring.paused || !ring.layout) return;
        ring.shift =
          (ring.shift + (ring.layout.perimeter * dt) / LAP_SECONDS) %
          ring.layout.perimeter;
        place(ring);
      });
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
</script>

<style>
  .logo-ring {
    --gap: var(--space-1);
    --logo-gap: var(--space-2);
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--ring-width);
    max-width: 100%;
    aspect-ratio: var(--ring-ratio);
  }

  /* Scales with the ring, so a narrow screen shrinks both together. */
  .logo-ring :global(.signature.ring) {
    width: 100%;
  }

  .logo-ring :global(.logo-container) {
    width: var(--logo-width);
  }

  .logo-ring :global(.logo-link) {
    width: 100%;
  }

  .ring {
    position: absolute;
    inset: 0;
  }

  .ring svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* No letter-spacing: browsers disagree on whether the space after the last
     letter counts towards a label's length, which shifts it off-centre. */
  text,
  .measure {
    font-family: sans-serif;
    font-size: 16px;
    text-transform: uppercase;
  }

  .measure {
    position: absolute;
    visibility: hidden;
    white-space: nowrap;
    pointer-events: none;
  }

  text {
    fill: var(--color-body-secondary);
    text-anchor: middle;
    dominant-baseline: alphabetic;
  }

  .separator {
    fill: var(--color-body-tertiary);
  }

  a text {
    transition: fill 0.15s ease;
  }

  a:hover text,
  a:focus-visible text,
  a[aria-current="page"] text {
    fill: var(--color-highlight);
  }

  a:focus-visible {
    outline: none;
  }

  a:focus-visible text {
    text-decoration: underline;
  }
</style>
