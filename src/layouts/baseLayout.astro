---
const { title, breadcrumbs, actions } = Astro.props;
import Breadcrumbs from "../components/breadcrumbs.astro";
import MetaTags from "../components/metaTags.astro";
import Footer from "../components/footer.astro";
import Button from "../components/button.astro";
---

<html lang="en">
  <head>
    <title>Raunaq Gupta / {title}</title>
    <MetaTags />
  </head>
  <body>
    <header>
      <Breadcrumbs breadcrumbs={breadcrumbs} />
      <div class="heading">
        <h1>{title}</h1>
        {
          actions && (
            <div class="actions">
              {actions.map((action) => (
                <Button {...action} />
              ))}
            </div>
          )
        }
      </div>
    </header>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --space-0: 4px;
    --space-1: 8px;
    --space-2: 16px;
    --space-3: 24px;
    --color-bg: #f6f6f6;
    --color-heading: #333;
    --color-body-primary: #111;
    --color-body-secondary: #666;
    --color-body-tertiary: #999;
    --color-highlight: #00659b;
    --color-border: #d8d8d8;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-bg: #1e2227;
      --color-heading: #e7e7e7;
      --color-body-primary: #dcdcdc;
      --color-body-secondary: #a9b0b7;
      --color-body-tertiary: #7f8891;
      --color-highlight: #39a5e6;
      --color-border: #2c3238;
    }
  }

  @font-face {
    font-family: "DMSerifDisplay";
    src: local("DMSerifDisplay"), url("/fonts/DMSerifDisplay-Italic.ttf");
    font-display: swap;
  }

  html {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: -webkit-fill-available;
  }

  body {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 4em 8em 0;
    font-size: 1.23em;
    max-width: 77ch;
    line-height: 28px;
    font-family: sans-serif;
    background-color: var(--color-bg);
    color: var(--color-body-primary);
    flex-grow: 1;
  }

  main {
    flex-grow: 1;
  }

  h1 {
    margin: 0;
    font-weight: 200;
    line-height: 1.12em;
    font-family: "DMSerifDisplay";
  }

  h2 {
    margin-top: 2em;
    font-weight: 200;
    font-size: 1.2em;
    color: var(--color-heading);
  }

  h3 {
    margin-bottom: 0;
  }

  figure {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    width: 100%;
  }

  figcaption {
    font-size: 14px;
    color: var(--color-body-secondary);
    padding: 4px 0px;
  }

  figure > img {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  time {
    color: var(--color-body-secondary);
  }

  ol {
    padding-inline-start: 1.5em;
  }

  ul {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    padding-inline-start: 0;
    gap: 8px;
  }

  ul.styled {
    list-style-type: disc;
    padding-inline-start: 1em;
  }

  a {
    display: inline;
    text-decoration: none;
    padding-bottom: 1px;
    box-sizing: border-box;
    color: var(--color-body-primary);
    position: relative;
    text-decoration-line: underline;
    text-decoration-style: solid;
    text-underline-offset: 5px;
    text-decoration-color: var(--color-border);
    text-decoration-skip-ink: auto;
    transition: text-decoration-color 0.5s ease-out;
  }

  a:after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    border-bottom: 2px solid var(--color-highlight);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease-out;
  }

  a:hover::after,
  a:focus::after {
    transform: scaleX(1);
  }

  a:hover,
  a:focus {
    text-decoration-color: var(--color-highlight);
  }

  .heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  @media only screen and (max-width: 1024px) {
    body {
      padding: 4e 4em 0;
    }
  }

  @media only screen and (max-width: 700px) {
    body {
      padding: 2em 1.5em 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a::after {
      transition: none;
    }
  }
</style>
