---
import Logo from "@components/logo.astro";
import { ROUTES } from "../constants";
import { layoutRing } from "./logoRing.layout";

const { current } = Astro.props;

const links = [
  { label: "Home", href: ROUTES.HOME },
  { label: "Portfolio", href: ROUTES.PORTFOLIO },
  { label: "Resume", href: ROUTES.RESUME },
  { label: "Blog", href: ROUTES.BLOG },
];

// Must match the CSS below and --space-0 in baseLayout. These give a close
// first render; the script re-measures the real text and corrects the layout.
const FONT_SIZE = 12;
const LETTER_SPACING = 0.12 * FONT_SIZE;
const DOT = 3;
const GAP = 4;
const estimatedCharWidth = 0.68 * FONT_SIZE + LETTER_SPACING;

const CAP_HEIGHT = 0.72 * FONT_SIZE;

const layout = layoutRing({
  labelWidths: links.map(
    ({ label }) => label.length * estimatedCharWidth - LETTER_SPACING,
  ),
  dot: DOT,
  gap: GAP,
  textHeight: CAP_HEIGHT,
});
---

<div
  class="logo-ring"
  style={`--ring-size: ${layout.size}px; --logo-size: ${layout.logo}px;`}
>
  <Logo mode="3d" size="large" />
  <nav class="ring" aria-label="Site">
    <svg
      viewBox={`0 0 ${layout.size} ${layout.size}`}
      data-dot={DOT}
      data-letter-spacing={LETTER_SPACING}
    >
      <defs>
        <path id="logo-ring-path" d={layout.path} />
      </defs>
      {
        layout.dots.map(({ x, y }) => (
          <circle class="separator" cx={x} cy={y} r={DOT / 2} />
        ))
      }
      {
        links.map(({ label, href }, i) => (
          <a href={href} aria-current={current === href ? "page" : undefined}>
            <text dy={CAP_HEIGHT / 2}>
              <textPath
                href="#logo-ring-path"
                startOffset={layout.labelOffsets[i]}
              >
                {label}
              </textPath>
            </text>
          </a>
        ))
      }
    </svg>
  </nav>
</div>

<script>
  import { layoutRing } from "./logoRing.layout";

  function fit(root: HTMLElement) {
    const svg = root.querySelector("svg")!;
    const texts = [...svg.querySelectorAll<SVGTextElement>("text")];
    const style = getComputedStyle(texts[0]);
    const letterSpacing = Number(svg.dataset.letterSpacing);
    const gap = parseFloat(getComputedStyle(root).getPropertyValue("--gap"));

    // Cap height of the label font, so the logo can sit one gap inside it.
    const ctx = document.createElement("canvas").getContext("2d")!;
    ctx.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
    const textHeight = ctx.measureText("H").actualBoundingBoxAscent;

    const layout = layoutRing({
      // getComputedTextLength includes the letter-spacing after the last glyph.
      labelWidths: texts.map((t) => t.getComputedTextLength() - letterSpacing),
      dot: Number(svg.dataset.dot),
      gap,
      textHeight,
    });

    root.style.setProperty("--ring-size", `${layout.size}px`);
    root.style.setProperty("--logo-size", `${layout.logo}px`);
    svg.setAttribute("viewBox", `0 0 ${layout.size} ${layout.size}`);
    // Centre the capitals on the circle rather than sitting on it.
    texts.forEach((t) => t.setAttribute("dy", String(textHeight / 2)));
    svg.querySelector("path")!.setAttribute("d", layout.path);
    svg.querySelectorAll("circle").forEach((circle, i) => {
      circle.setAttribute("cx", String(layout.dots[i].x));
      circle.setAttribute("cy", String(layout.dots[i].y));
    });
    svg.querySelectorAll("textPath").forEach((textPath, i) => {
      textPath.setAttribute("startOffset", String(layout.labelOffsets[i]));
    });
  }

  const rings = document.querySelectorAll<HTMLElement>(".logo-ring");
  rings.forEach(fit);
  document.fonts.ready.then(() => rings.forEach(fit));
</script>

<style>
  .logo-ring {
    --gap: var(--space-0);
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--ring-size);
    height: var(--ring-size);
  }

  .logo-ring :global(.logo-3d) {
    width: var(--logo-size);
    height: var(--logo-size);
  }

  .ring {
    position: absolute;
    inset: 0;
  }

  .ring svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: spin 20s linear infinite;
  }

  .logo-ring:hover svg,
  .logo-ring:focus-within svg {
    animation-play-state: paused;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media only screen and (max-width: 700px) {
    .ring svg {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring svg {
      animation: none;
    }
  }

  text {
    fill: var(--color-body-secondary);
    font-family: sans-serif;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-anchor: middle;
    dominant-baseline: alphabetic;
  }

  .separator {
    fill: var(--color-body-tertiary);
  }

  a text {
    transition: fill 0.15s ease;
  }

  a:hover text,
  a:focus-visible text,
  a[aria-current="page"] text {
    fill: var(--color-highlight);
  }

  a:focus-visible {
    outline: none;
  }

  a:focus-visible text {
    text-decoration: underline;
  }
</style>
