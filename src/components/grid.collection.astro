---
import CaseStudyBig from "./caseStudy.big.astro";
import CaseStudyCollection from "@components/caseStudy.collection.astro";

const { type, collection } = Astro.props;
const sortedCollection = [...collection].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<section>
  {
    sortedCollection.map((item) =>
      type === "collection" ? (
        <CaseStudyCollection
          image={item.data.thumbnail}
          name={item.data.organization}
          title={item.data.title}
          description={item.data.description}
          url={item.slug}
          caseStudyCount={
            Array.isArray(item.data.caseStudies)
              ? item.data.caseStudies.length
              : null
          }
        />
      ) : (
        <CaseStudyBig
          image={item.data.thumbnail}
          name={item.data.product}
          title={item.data.title}
          description={item.data.description}
          url={item.slug}
        />
      ),
    )
  }
</section>

<style>
  section {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: var(--space-3);
    width: 100%;
  }

  section > * {
    display: flex;
  }

  @media only screen and (max-width: 700px) {
    section {
      grid-template-columns: 1fr;
    }
  }
</style>
