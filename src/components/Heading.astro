---
const { title, actions, textAlign = "left" } = Astro.props;
import Button from "@components/button.astro";
---

<div class="heading">
  <h1 style={`--text-align: ${textAlign}`}>{title}</h1>
  {
    actions && (
      <div class="actions">
        {actions.map((action) => (
          <Button {...action} />
        ))}
      </div>
    )
  }
</div>

<style>
  .heading {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .heading h1 {
    flex: 1;
    text-align: var(--text-align);
  }

  .heading .actions {
    display: flex;
    flex-direction: row;
    gap: var(--space-1);
  }
</style>
