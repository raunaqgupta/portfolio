---
import BaseLayout from "../../layouts/baseLayout.astro";
import Imgmdx from "../../components/img.mdx.astro";

import { getCollection } from "astro:content";
import Toolbar from "../../components/toolbar.astro";
export async function getStaticPaths() {
  const blog = await getCollection("blog");
  return blog.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, components } = await entry.render();
const links = [
  { text: "Raunaq Gupta", url: "/" },
  { text: "Blog", url: "/blog" },
];

const format = { year: "numeric", month: "long", day: "numeric" };
---

<BaseLayout title={entry.data.title} breadcrumbs={links}>
  <Content components={{ ...components, img: Imgmdx }} />
  <Toolbar
    >{entry.data.date.toLocaleDateString("en-US", format)} ○ {
      entry.data.category
    }</Toolbar
  >
</BaseLayout>
