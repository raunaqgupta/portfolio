---
interface Props {
  message?: string;
}

const { message } = Astro.props;
import InfoCircled from "@icons/info-circled.svg";
---

<div class="message">
  <span class="severity"><InfoCircled /></span><span class="text">
    {message}</span
  >
</div>

<style>
  .message {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    padding: 0 var(--space-1);
    background-color: color-mix(in srgb, var(--color-info) 10%, transparent);
    border-radius: 6px;
  }

  .text {
    font-size: var(--typography-body);
  }

  .severity {
    color: var(--color-info);
  }

  @media only screen and (max-width: 700px) {
    .message {
      align-items: flex-start;
      padding: var(--space-1);
    }

    .text {
      line-height: 1.5em;
    }
  }
</style>
