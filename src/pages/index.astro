---
import LogoRing from "@components/logoRing.astro";
import GridBackground from "@components/gridBackground.astro";
import BowlCard from "@components/bowlCard.astro";
import Showcase from "@components/showcase.astro";
import SpeakerLoudIcon from "@icons/speaker-loud.svg";
import BaseLayout from "../layouts/baseLayout.astro";
import { SITE_URL } from "../constants";

// The grid's warp; the cards bend with it as they scroll.
const CURVE = 0.5;

const PRONUNCIATION_URL =
  "https://audio.raunaqgupta.com/Pronunciation%3A%20Raunaq.m4a";

const description =
  "Personal website of Raunaq Gupta - Design technologist with 10+ years of experience shipping enterprise web applications and developer tools.";
---

<BaseLayout title="Home" description={description} canonicalUrl={SITE_URL}>
  <body>
    <GridBackground
      cellSize={10.5}
      density={0.12}
      rate={12}
      hold={[400, 1200]}
      curve={CURVE}
    />
    <main>
      <BowlCard curve={CURVE} class="card intro">
        <div class="intro-inner">
          <LogoRing />

          <div class="content">
            <div class="name">
              <button
                class="pronounce"
                type="button"
                aria-label="Play pronunciation of Raunaq"
              >
                <SpeakerLoudIcon aria-hidden="true" />
              </button>
              <h1>
                <span class="visually-hidden">Raunaq, pronounced </span>
                <span lang="en-fonipa">/ˈrɔː.nʌk/</span>
              </h1>
              <audio preload="auto" src={PRONUNCIATION_URL}></audio>
            </div>
            <p>
              I'm a product, and design specialist with over 10 years of experience shipping enterprise web
              applications across startups and large organizations.
            </p>
            <p>Reach out at <a href="mailto:mail@raunaqgupta.com">mail@raunaqgupta.com</a> to discuss opportunities.</p>
          </div>
        </div>
      </BowlCard>

      <Showcase collection="o11y" curve={CURVE} />
      <Showcase collection="planetscale" curve={CURVE} />
    </main>
  </body>
</BaseLayout>

<script>
  // The audio button plays the recorded pronunciation, from the start each
  // time it's pressed. The clip is small, so it's preloaded with the page.
  document.querySelectorAll<HTMLElement>(".name").forEach((name) => {
    const button = name.querySelector<HTMLButtonElement>(".pronounce")!;
    const audio = name.querySelector("audio")!;
    button.addEventListener("click", () => {
      // Rewind only once the clip has loaded: some browsers throw when
      // seeking before that, which would stop play() from running.
      try {
        if (audio.readyState > 0) audio.currentTime = 0;
      } catch {}
      // play() runs inside the click, so autoplay rules allow it.
      const playing = audio.play();
      playing?.catch((error) => {
        button.classList.remove("is-playing");
        console.warn("Pronunciation audio didn't play:", error);
      });
    });
    audio.addEventListener("play", () => button.classList.add("is-playing"));
    for (const end of ["pause", "ended", "error"])
      audio.addEventListener(end, () => button.classList.remove("is-playing"));
  });
</script>

<style>
  body {
    margin: 0;
    background-color: var(--color-bg);
    color: var(--color-body-primary);
    font-family: sans-serif;
    font-size: 1.12em;
    line-height: 28px;
  }

  /* Above the grid background. Clipped, because the bent cards reach past
     the viewport's sides and would otherwise make the page scroll sideways.
     Clip, unlike hidden, doesn't make main a scroll container. */
  main {
    position: relative;
    z-index: 1;
    overflow: clip;
  }

  /* The intro fills the viewport; its content sits in the middle. */
  main > :global(.intro) {
    min-height: 100vh;
    min-height: 100dvh;
  }

  .intro-inner {
    box-sizing: border-box;
    flex: 1;
    display: flex;
    align-items: center;
    flex-direction: row;
    gap: 64px;
    width: 100%;
    max-width: 80ch;
    margin: auto;
  }

  .content {
    flex: 0 1 600px;
  }

  .content p {
    margin: 19px 0 0;
    font-size: var(--typography-body);
  }

  /* Pronunciation: an audio button beside the name in IPA. */
  .name {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .pronounce {
    all: unset;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-heading);
    color: var(--color-bg);
    cursor: pointer;
    transition:
      transform 150ms ease-out,
      background-color 150ms;
  }

  .pronounce :global(svg) {
    width: 24px;
    height: 24px;
  }

  .pronounce:hover {
    transform: scale(1.06);
  }

  .pronounce:active {
    transform: scale(0.96);
  }

  .pronounce:focus-visible {
    outline: 2px solid var(--color-highlight);
    outline-offset: 3px;
  }

  /* While the recording plays. */
  .pronounce.is-playing {
    background-color: var(--color-highlight);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media only screen and (max-width: 700px) {
    .intro-inner {
      padding: 2em;
    }

    .intro-inner {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 32px;
    }

    .content {
      flex: none;
    }

    h1 {
      font-size: 2.56rem;
    }

    .name {
      gap: var(--space-2);
    }
  }
</style>
