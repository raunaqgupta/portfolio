---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  robots?: string;
  canonicalUrl?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    hero?: string;
    thumbnail?: string;
    date?: Date;
  };
}

const {
  robots,
  description,
  image,
  type,
  publishedTime,
  modifiedTime,
  author,
  canonicalUrl,
  frontmatter,
} = Astro.props;
const title = Astro.props.title || frontmatter?.title || "Untitled";
const seoDescription = description || frontmatter?.description;
const seoImage = image || frontmatter?.hero || frontmatter?.thumbnail;
const seoPublishedTime = publishedTime || frontmatter?.date?.toISOString();

import Head from "@components/head.astro";
---

<html lang="en">
  <Head
    title={title}
    description={seoDescription}
    image={seoImage}
    type={type}
    publishedTime={seoPublishedTime}
    modifiedTime={modifiedTime}
    author={author}
    robots={robots}
    canonicalUrl={canonicalUrl}
  />
  <slot />
</html>

<style is:global>
  :root {
    --color-bg: #fcfcfc;
    --color-bg-invert: #1e2227;
    --color-bg-1: #eaeaea;
    --color-bg-glass: rgba(24, 24, 24, 0.1);
    --color-border: #d8d8d8;
    --color-border-1: #d0d0d0;
    --color-border-bg: rgba(200, 200, 200, 0.15);
    --color-body-primary: #3f3f3f;
    --color-body-secondary: #666;
    --color-body-tertiary: #999;
    --color-heading: #111;
    --color-highlight: oklch(0.45 0.13 240);
    --color-info: oklch(0.62 0.22 252);
    --typography-body: 1.2rem;
    --typography-body-small: 0.875rem;
    --typography-h1: 3rem;
    --typography-h2: 2rem;
    --typography-h3: 1.75rem;
    --typography-h4: 1.25rem;
    --space-0: 4px;
    --space-1: 8px;
    --space-2: 16px;
    --space-3: 24px;
    --space-4: 32px;
    --border-radius: 6px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-bg: #1e2227;
      --color-bg-invert: #f6f6f6;
      --color-bg-1: #2c3238;
      --color-bg-glass: rgba(250, 250, 250, 0.1);
      --color-border: #353c43;
      --color-border-1: #3a4046;
      --color-border-bg: #1b1e22;
      --color-body-primary: #dcdcdc;
      --color-body-secondary: #a9b0b7;
      --color-body-tertiary: #7f8891;
      --color-heading: #e7e7e7;
      --color-highlight: #39a5e6;
    }

    .astro-code,
    .astro-code span {
      color: var(--shiki-dark) !important;
      background-color: var(--shiki-dark-bg) !important;
    }
  }

  @media only screen and (max-width: 700px) {
    :root {
      --typography-h1: 1.75em;
      --typography-h2: 1.2em;
      --typography-h3: 1em;
      --typography-h4: 0.9em;
    }
  }

  h1 {
    color: var(--color-heading);
    font-family: var(--font-cal-sans), sans-serif;
    font-size: var(--typography-h1);
    line-height: 1.12em;
    margin: 0;
  }

  h2 {
    color: var(--color-heading);
    font-size: var(--typography-h2);
    line-height: 1.25;
    margin-top: 2.5em;
  }

  h3 {
    color: var(--color-heading);
    font-size: var(--typography-h3);
    margin-top: 1em;
  }

  h4 {
    color: var(--color-heading);
    font-size: var(--typography-h4);
    margin-top: 1.5em;
  }

  blockquote {
    box-sizing: border-box;
    border-left: 4px solid var(--color-border);
    padding-left: var(--space-3);
    color: var(--color-body-secondary);
    font-style: italic;
    font-size: var(--typography-body);
  }

  p {
    font-size: var(--typography-body);
    max-width: 80ch;
  }

  figure {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    width: 100%;
  }

  figcaption {
    color: var(--color-body-secondary);
    font-size: 14px;
    padding: 4px 0px;
  }

  figure > img {
    background-image:
      linear-gradient(rgba(200, 200, 200, 0.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(200, 200, 200, 0.15) 1px, transparent 1px);
    background-size: 8px 8px;
    border: 1px solid rgba(200, 200, 200, 0.4);
    border-radius: 12px;
    width: 100%;
  }

  time {
    color: var(--color-body-secondary);
  }

  a {
    color: var(--color-body-primary);
    position: relative;
    text-decoration: none;
    background-image:
      linear-gradient(to right, var(--color-highlight), var(--color-highlight)),
      linear-gradient(to right, var(--color-border), var(--color-border));
    background-position:
      0 100%,
      0 100%;
    background-repeat: no-repeat, no-repeat;
    background-size:
      0% 2px,
      100% 1px;
    transition: background-size 0.2s ease-out;
  }

  a:hover,
  a:focus {
    background-size:
      100% 2px,
      100% 1px;
  }

  a.no-decoration {
    background-image: linear-gradient(
      to right,
      var(--color-highlight),
      var(--color-highlight)
    );
    background-size: 0% 2px;
  }

  a.no-decoration:hover,
  a.no-decoration:focus {
    background-size: 100% 2px;
  }

  a.no-hover:hover,
  a.no-hover:focus {
    background-image: none;
  }

  a.active {
    color: var(--color-body-primary);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }

  ul,
  ol {
    box-sizing: border-box;
    padding-inline-start: 1.5em;
    font-size: var(--typography-body);
  }

  code {
    background-color: var(--color-bg-1);
    border-radius: var(--space-0);
    padding: 0.2em 0.4em;
    font-size: var(--typography-body-small);
  }

  table {
    width: 100%;
    border: 1px solid var(--color-border);
    padding: var(--space-1);
    border-radius: var(--border-radius);
  }

  thead {
    font-size: var(--typography-body-small);
    font-weight: 200;
    text-align: left;
  }

  tbody {
    font-size: var(--typography-body-small);
    text-align: left;
  }

  @media (prefers-reduced-motion: reduce) {
    a::after {
      transition: none;
    }
  }
</style>
