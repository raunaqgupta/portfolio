---
const { image, title, description, url } = Astro.props;
---

<a href={url}>
  <article>
    <img src={image} />
    <h2>{title}</h2>
    <p>{description}</p>
  </article>
</a>

<style>
  a {
    border: unset;
    text-decoration: none;
  }

  a:after {
    content: none;
  }

  a:hover article {
    border-color: black;
  }

  article {
    display: flex;
    flex-direction: row;
    background-color: #eaeaea;
    border: 1px solid #eaeaea;
    border-radius: 6px;
    padding: var(--space-3);
    gap: var(--space-2);
  }

  img {
    width: 100%;
    max-width: 300px;
    border: 1px solid #ccc;
    border-radius: 6px;
  }

  h2 {
    margin: 8px 16px;
    font-size: 1em;
  }
</style>
