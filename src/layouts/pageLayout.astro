---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  actions?: Array<{ label: string; url: string; isExternal?: boolean }>;
  robots?: string;
  breadcrumbs?: Array<{ text: string; url: string }>;
  canonicalUrl?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    hero?: string;
    thumbnail?: string;
    date?: Date;
  };
}

const {
  actions,
  robots,
  breadcrumbs,
  description,
  image,
  type,
  publishedTime,
  modifiedTime,
  author,
  canonicalUrl,
  frontmatter,
} = Astro.props;
const title = Astro.props.title || frontmatter?.title || "Untitled";

import BaseLayout from "../layouts/baseLayout.astro";
import Footer from "@components/footer.astro";
import Heading from "@components/Heading.astro";
import Modal from "@components/modal.astro";
import Header from "@components/header.astro";
import Breadcrumbs from "@components/breadcrumbs.astro";
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type={type}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={author}
  robots={robots}
  canonicalUrl={canonicalUrl}
  frontmatter={frontmatter}
>
  <body>
    <Header />
    <main>
      {breadcrumbs && <Breadcrumbs breadcrumbs={breadcrumbs} />}
      <Modal />
      <Heading title={title} actions={actions} />
      <slot />
    </main>
    <Footer />
  </body>
</BaseLayout>

<style>
  body {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg);
    color: var(--color-body-primary);
    font-family: sans-serif;
    font-size: 1.12em;
    line-height: 28px;
    margin: 0 auto;
    max-width: 120ch;
    min-height: 100vh;
    min-height: 100dvh;
    padding: 8em 8em 0;
  }

  main {
    flex: 1;
  }

  @media only screen and (max-width: 1024px) {
    body {
      padding: 4em 4em 0;
    }
  }

  @media only screen and (max-width: 700px) {
    body {
      min-width: unset;
      padding: 2em 1.5em 0;
    }
  }
</style>
