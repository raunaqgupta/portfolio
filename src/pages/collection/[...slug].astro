---
import PageLayout from "../../layouts/pageLayout.astro";
import Imgmdx from "@components/img.mdx.astro";
import Ulmdx from "@components/ul.mdx.astro";
import Listmdx from "@components/list.mdx.astro";
import Hero from "@components/hero.astro";

import { getCollection } from "astro:content";
export async function getStaticPaths() {
  const products = await getCollection("articles", ({ data }) => {
    return data.category === "collection";
  });
  return products.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, components } = await entry.render();
const links = [
  { text: "Raunaq Gupta", url: "/" },
  { text: "Portfolio", url: "/portfolio" },
];
---

<PageLayout title={entry.data.title} breadcrumbs={links}>
  <Hero imageUrl={entry.data.hero} />
  <Content
    components={{ ...components, img: Imgmdx, ul: Ulmdx, List: Listmdx }}
  />
</PageLayout>
