---
const {
  label,
  url,
  iconOnly = false,
  isLink,
  isExternalLink,
  isDownload,
  preIcon: PreIcon,
  postIcon: PostIcon,
} = Astro.props;

import ExternalLinkIcon from "../assets/icons/external-link.svg";
---

{
  isLink ? (
    <a
      class="button"
      href={url}
      {...(isExternalLink
        ? { target: "_blank", rel: "noopener noreferrer" }
        : {})}
      {...(isDownload ? { download: true } : {})}
    >
      {PreIcon && <PreIcon />}
      {iconOnly ? "" : label}
      {PostIcon && <PostIcon />}
      {isExternalLink && <ExternalLinkIcon />}
    </a>
  ) : (
    <button onclick={url}>
      {PreIcon && <PreIcon />}
      {iconOnly ? "" : label}
      {PostIcon && <PostIcon />}
    </button>
  )
}

<style>
  button,
  a.button {
    text-decoration: none;
    font-size: 0.8em;
    display: inline-flex;
    flex-direction: row;
    gap: var(--space-1);
    align-items: center;
    cursor: pointer;
    color: var(--color-bg);
    background: var(--color-bg-invert);
    padding: var(--space-0) var(--space-2);
    border-radius: 99px;
    transition: background-color 160ms ease;
  }

  button:hover,
  a.button:hover {
    background-color: var(--color-highlight);
  }

  a.button:after {
    content: none;
  }
</style>
