---
import NarrowLayout from "@layouts/NarrowLayout.astro";
import Imgmdx from "@components/img.mdx.astro";
import Prose from "@components/Prose.astro";
import { getCollection, render } from "astro:content";
import PostDetails from "@components/PostDetails.astro";
import { formatDate } from "../../utils";

export async function getStaticPaths() {
  try {
    const blog = await getCollection("articles", ({ data }) => {
      return data.internal === true;
    });
    return blog.map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
  } catch (error) {
    console.error("Error generating internal paths:", error);
    return [];
  }
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect("/404");
}

const { Content } = await render(entry);
---

<NarrowLayout
  title={entry.data.title}
  robots="noindex, nofollow"
  frontmatter={entry.data}
>
  <Prose><Content components={{ img: Imgmdx }} /></Prose>
  <PostDetails>
    <div class="date">
      {formatDate(entry.data.date)}
    </div>
    <div class="separator">-</div>
    <div class="category">
      {entry.data.category}
    </div>
  </PostDetails>
</NarrowLayout>

<style>
  .date,
  .separator,
  .category {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .category {
    text-transform: capitalize;
  }
</style>
