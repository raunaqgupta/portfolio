---
import { getCollection, render } from "astro:content";
import LogoRing from "@components/logoRing.astro";
import GridBackground from "@components/gridBackground.astro";
import Prose from "@components/Prose.astro";
import Imgmdx from "@components/img.mdx.astro";
import Ulmdx from "@components/ul.mdx.astro";
import Codemdx from "@components/Code.mdx.astro";
import ChevronUpIcon from "@icons/chevron-up.svg";
import ChevronDownIcon from "@icons/chevron-down.svg";
import ThickArrowRightIcon from "@icons/thick-arrow-right.svg";
import CrossIcon from "@icons/cross.svg";
import BaseLayout from "../layouts/baseLayout.astro";
import { ROUTES, SITE_URL } from "../constants";

const description =
  "Personal website of Raunaq Gupta - Design technologist with 10+ years of experience shipping enterprise web applications and developer tools.";

let caseStudies: Awaited<ReturnType<typeof getCollection<"articles">>> = [];
try {
  caseStudies = await getCollection("articles", ({ data }) => {
    return data.published !== false && data.category === "portfolio";
  });
} catch (error) {
  console.error("Error fetching case studies:", error);
}

const cards = await Promise.all(
  caseStudies
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map(async (entry) => ({
      href: `${ROUTES.PORTFOLIO}/${entry.id}`,
      title: entry.data.title,
      image: entry.data.thumbnail ?? entry.data.hero,
      hero: entry.data.hero ?? entry.data.thumbnail,
      Content: (await render(entry)).Content,
    })),
);
---

<BaseLayout title="Home" description={description} canonicalUrl={SITE_URL}>
  <body>
    <GridBackground />
    <main class="deck" style={`--count: ${cards.length + 1};`}>
      <div class="stage">
        <section class="card intro" data-card>
          <LogoRing />
          <div class="content">
            <h1>Hi, I'm Raunaq</h1>
            <p>
              If you are interested in hiring me, visit my <a
                href={ROUTES.PORTFOLIO}>portfolio</a
              >. Check out my <a href={ROUTES.BLOG}>blog</a>, and <a
                href="https://raunaqgupta.substack.com/notes">Substack notes</a
              > where I write about experiments in technology & design, recipes,
              and literature. I'm machine readable at <a
                href="/raunaq-gupta.json">raunaq-gupta.json</a
              >.
            </p>
          </div>
        </section>
        {
          cards.map((card, i) => (
            <a
              class="card case no-decoration no-hover"
              href={card.href}
              data-card
              data-case={i}
            >
              <div class="title">
                <h2>{card.title}</h2>
                <ThickArrowRightIcon class="arrow" aria-hidden="true" />
              </div>
              <div class="image" style={`--img: url("${card.image}")`} />
            </a>
          ))
        }
        <nav class="indicator" aria-label="Cards">
          <button
            class="step"
            type="button"
            data-step="-1"
            aria-label="Previous card"
          >
            <ChevronUpIcon class="chevron" />
          </button>
          <div class="window">
            <ol class="numbers">
              <li class="dot" aria-hidden="true">•</li>
              {
                Array.from({ length: cards.length + 1 }, (_, i) => (
                  <li>
                    <button
                      type="button"
                      data-goto={i}
                      aria-label={`Card ${i + 1}`}
                    >
                      {i + 1}
                    </button>
                  </li>
                ))
              }
              <li class="dot" aria-hidden="true">•</li>
            </ol>
          </div>
          <button
            class="step"
            type="button"
            data-step="1"
            aria-label="Next card"
          >
            <ChevronDownIcon class="chevron" />
          </button>
        </nav>
      </div>
      {
        Array.from({ length: cards.length + 1 }, (_, i) => (
          <div class="snap" style={`--i: ${i};`} aria-hidden="true" />
        ))
      }
    </main>

    <dialog class="case-modal" aria-labelledby="case-modal-title">
      <div class="scrim"></div>
      <article class="panel">
        <button class="close" type="button" aria-label="Close">
          <CrossIcon />
        </button>
        <div class="body"></div>
      </article>
    </dialog>

    {
      cards.map((card, i) => (
        <template data-case-content={i}>
          <h1 id="case-modal-title">{card.title}</h1>
          <div class="hero" style={`--img: url("${card.hero}")`} />
          <Prose>
            <card.Content
              components={{ img: Imgmdx, ul: Ulmdx, code: Codemdx }}
            />
          </Prose>
        </template>
      ))
    }
  </body>
</BaseLayout>

<script>
  // Scroll-driven card deck. Keyframes come from three design frames
  // (1280×832), where a card fills the viewport inside a 64px margin:
  // a card resting, the next card halfway in, and the next card resting.
  // The outgoing card doesn't move up; it shrinks back in place while the
  // next one rises from the bottom and covers it.
  //
  // For each card, d = its index minus the scroll position (in cards):
  //   d = 1    just below the viewport
  //   d = 0.5  incoming: top at 438/832 of the viewport, opacity 0.75
  //   d = 0    resting
  //   d = -0.5 outgoing: scale 787/1073, opacity 0.5, centred in place
  //   d = -1   gone behind the card now resting in front of it
  const FRAME_H = 832;
  const FRAME_MARGIN = 64;
  const IN_MID = (438 - FRAME_MARGIN) / FRAME_H;
  const OUT_MID_SCALE = 787 / 1073;
  const OUT_END_SCALE = 0.6;

  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const ease = (t: number) => t * t * (3 - 2 * t);

  function init(deck: HTMLElement) {
    const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");
    const stage = deck.querySelector<HTMLElement>(".stage")!;
    const cards = [...deck.querySelectorAll<HTMLElement>("[data-card]")];
    let viewport = 0;
    let frame = 0;

    const indicator = deck.querySelector<HTMLElement>(".indicator")!;
    const numbers = [
      ...indicator.querySelectorAll<HTMLElement>(".numbers li"),
    ];
    const goto = [
      ...indicator.querySelectorAll<HTMLButtonElement>("[data-goto]"),
    ];
    const steps = [
      ...indicator.querySelectorAll<HTMLButtonElement>("[data-step]"),
    ];
    let current = -1;

    function scrollToCard(i: number) {
      const index = Math.min(Math.max(i, 0), cards.length - 1);
      const y =
        window.scrollY + deck.getBoundingClientRect().top + index * viewport;
      window.scrollTo({ top: y, behavior: "smooth" });
    }

    goto.forEach((button) =>
      button.addEventListener("click", () =>
        scrollToCard(Number(button.dataset.goto)),
      ),
    );
    steps.forEach((button) =>
      button.addEventListener("click", () =>
        scrollToCard(Math.max(current, 0) + Number(button.dataset.step)),
      ),
    );

    // The number column rolls with the scroll position: the current number
    // sits in the middle row, its neighbours fade above and below it.
    function renderIndicator(p: number) {
      indicator.style.setProperty("--p", String(p));
      numbers.forEach((item, j) => {
        // Item 0 is the dot before the first card.
        const distance = Math.abs(j - 1 - p);
        item.style.opacity = String(
          Math.max(0, 1 - Math.max(distance - 1, 0) * 2),
        );
        item.classList.toggle("is-current", distance < 0.5);
      });
      const index = Math.round(p);
      if (index === current) return;
      current = index;
      goto.forEach((button, i) => {
        if (i === index) button.setAttribute("aria-current", "step");
        else button.removeAttribute("aria-current");
        // Only the numbers in view can take focus.
        button.tabIndex = Math.abs(i - index) <= 1 ? 0 : -1;
      });
      steps[0].disabled = index <= 0;
      steps[1].disabled = index >= cards.length - 1;
    }

    function render() {
      frame = 0;
      const H = viewport;
      const p = Math.min(
        Math.max(-deck.getBoundingClientRect().top / H, 0),
        cards.length - 1,
      );
      renderIndicator(p);

      cards.forEach((card, i) => {
        const d = i - p;
        const margin = card.offsetTop;
        let y = 0;
        let scale = 1;
        let opacity = 1;

        if (d >= 1) {
          y = H - margin;
          opacity = 0;
        } else if (d > 0) {
          const mid = IN_MID * H;
          if (d > 0.5) {
            const t = ease((d - 0.5) / 0.5);
            y = lerp(mid, H - margin, t);
            opacity = lerp(0.75, 0.5, t);
          } else {
            const t = ease(d / 0.5);
            y = lerp(0, mid, t);
            opacity = lerp(1, 0.75, t);
          }
        } else if (d < 0) {
          const a = -d;
          if (a <= 0.5) {
            const t = ease(a / 0.5);
            scale = lerp(1, OUT_MID_SCALE, t);
            opacity = lerp(1, 0.5, t);
          } else {
            const t = ease(Math.min((a - 0.5) / 0.5, 1));
            scale = lerp(OUT_MID_SCALE, OUT_END_SCALE, t);
            opacity = lerp(0.5, 0, t);
          }
        }

        card.style.transform = `translateY(${y}px) scale(${scale})`;
        card.style.setProperty("--fade", String(opacity));
        card.style.visibility = opacity <= 0 ? "hidden" : "visible";
        card.style.zIndex = String(i + 1);
        // Only the resting card takes pointer input.
        card.inert = Math.abs(d) >= 0.5;
      });
    }

    function schedule() {
      if (!frame) frame = requestAnimationFrame(render);
    }

    function measure() {
      viewport = stage.clientHeight;
    }

    function apply() {
      if (motion.matches) {
        deck.classList.add("is-stacked");
        measure();
        render();
      } else {
        deck.classList.remove("is-stacked");
        cards.forEach((card) => {
          card.removeAttribute("style");
          card.inert = false;
        });
      }
    }

    window.addEventListener("scroll", () => motion.matches && schedule(), {
      passive: true,
    });
    window.addEventListener("resize", () => {
      if (!motion.matches) return;
      measure();
      schedule();
    });
    motion.addEventListener("change", apply);
    apply();

    // Scroll the deck frame by frame (so the cards follow) to where a card
    // rests. Snapping is paused meanwhile so it doesn't fight the tween.
    function tweenScroll(to: number) {
      const from = window.scrollY;
      const delta = to - from;
      if (Math.abs(delta) < 1) return Promise.resolve();
      const duration = 200 + 300 * Math.min(Math.abs(delta) / viewport, 1);
      const root = document.documentElement;
      root.style.scrollSnapType = "none";
      return new Promise<void>((resolve) => {
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min((now - start) / duration, 1);
          window.scrollTo({ top: from + delta * ease(t), behavior: "instant" });
          if (t < 1) requestAnimationFrame(step);
          else {
            root.style.scrollSnapType = "";
            resolve();
          }
        };
        requestAnimationFrame(step);
      });
    }

    return {
      // Bring a card to rest, if it isn't already, and lay out the deck.
      async settle(card: HTMLElement) {
        const i = cards.indexOf(card);
        if (i < 0 || !motion.matches) return;
        const top =
          window.scrollY + deck.getBoundingClientRect().top + i * viewport;
        await tweenScroll(top);
        render();
      },
    };
  }

  type Deck = ReturnType<typeof init>;

  // Clicking a case card opens its page's content in a modal: the card
  // first comes to rest, then grows into the modal panel. Closing (Escape,
  // the close button, a click outside, Back, or scrolling on past the end)
  // shrinks the panel back into the card. The URL follows the modal, so it
  // can be shared. Modified clicks (new tab, new window) keep the plain link
  // behaviour.
  const DURATION = 450;
  const FADE = 200;
  const EASING = "cubic-bezier(0.2, 0.8, 0.2, 1)";

  type Rect = { left: number; top: number; width: number; height: number };

  function initModal(deck: Deck | undefined) {
    const dialog = document.querySelector<HTMLDialogElement>(".case-modal");
    if (!dialog) return;
    const panel = dialog.querySelector<HTMLElement>(".panel")!;
    const body = dialog.querySelector<HTMLElement>(".body")!;
    const scrim = dialog.querySelector<HTMLElement>(".scrim")!;
    const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");
    const homeTitle = document.title;
    const homeUrl = location.href;
    let activeCard: HTMLElement | null = null;
    let busy = false;

    // The part of an element inside the viewport.
    function visibleRect(el: HTMLElement): Rect {
      const r = el.getBoundingClientRect();
      const top = Math.max(r.top, 0);
      const bottom = Math.min(r.bottom, window.innerHeight);
      return { left: r.left, top, width: r.width, height: Math.max(bottom - top, 0) };
    }

    const box = (r: Rect) => ({
      left: `${r.left}px`,
      top: `${r.top}px`,
      width: `${r.width}px`,
      height: `${r.height}px`,
    });

    // A copy of the card that morphs between the card and the panel. It
    // keeps the card's styles, so its title and image reflow as it resizes.
    function makeGhost(card: HTMLElement, rect: Rect) {
      const ghost = card.cloneNode(true) as HTMLElement;
      ghost.removeAttribute("href");
      ghost.removeAttribute("data-card");
      ghost.removeAttribute("data-case");
      ghost.setAttribute("aria-hidden", "true");
      ghost.inert = true;
      ghost.classList.add("ghost");
      ghost.style.cssText = "";
      Object.assign(ghost.style, box(rect));
      dialog!.append(ghost);
      return ghost;
    }

    async function open(card: HTMLElement, i: number, href: string) {
      const template = document.querySelector<HTMLTemplateElement>(
        `template[data-case-content="${i}"]`,
      );
      if (!template || busy) return;
      busy = true;
      activeCard = card;
      await deck?.settle(card);

      body.replaceChildren(template.content.cloneNode(true));
      const animate = motion.matches;
      if (animate) {
        panel.style.opacity = "0";
        scrim.style.opacity = "0";
      }
      dialog!.showModal();
      dialog!.scrollTop = 0;
      const title = body.querySelector("h1")?.textContent;
      if (title) document.title = `${title} | Raunaq Gupta`;
      history.pushState({ caseModal: i }, "", href);

      if (animate) {
        const from = card.getBoundingClientRect();
        const to = visibleRect(panel);
        const cardStyle = getComputedStyle(card);
        const panelStyle = getComputedStyle(panel);
        const ghost = makeGhost(card, from);
        const timing = { duration: DURATION, easing: EASING, fill: "forwards" as const };
        const move = ghost.animate(
          [
            { ...box(from), borderColor: cardStyle.borderTopColor, boxShadow: "none" },
            { ...box(to), borderColor: panelStyle.borderTopColor, boxShadow: panelStyle.boxShadow },
          ],
          timing,
        );
        scrim.animate([{ opacity: 0 }, { opacity: 1 }], timing);
        await move.finished;

        // Cross-fade from the grown card to the case study.
        scrim.style.opacity = "";
        scrim.getAnimations().forEach((a) => a.cancel());
        panel.style.opacity = "";
        const reveal = panel.animate([{ opacity: 0 }, { opacity: 1 }], {
          duration: FADE,
          easing: "ease-out",
        });
        ghost
          .animate([{ opacity: 1 }, { opacity: 0 }], { duration: FADE, fill: "forwards" })
          .finished.then(() => ghost.remove());
        await reveal.finished;
      }
      busy = false;
    }

    async function close() {
      if (!dialog!.open || busy) return;
      busy = true;
      document.title = homeTitle;
      const card = activeCard;
      if (motion.matches && card?.isConnected) {
        const from = visibleRect(panel);
        const to = card.getBoundingClientRect();
        const cardStyle = getComputedStyle(card);
        const panelStyle = getComputedStyle(panel);
        const ghost = makeGhost(card, from);
        ghost.style.borderColor = panelStyle.borderTopColor;
        ghost.style.boxShadow = panelStyle.boxShadow;

        // Cross-fade from the case study to the card, at the panel's size.
        const fade = { duration: FADE, easing: "ease-out", fill: "forwards" as const };
        panel.animate([{ opacity: 1 }, { opacity: 0 }], fade);
        await ghost.animate([{ opacity: 0 }, { opacity: 1 }], fade).finished;
        panel.style.opacity = "0";
        panel.getAnimations().forEach((a) => a.cancel());

        const timing = { duration: DURATION, easing: EASING, fill: "forwards" as const };
        const move = ghost.animate(
          [
            { ...box(from), borderColor: panelStyle.borderTopColor, boxShadow: panelStyle.boxShadow },
            { ...box(to), borderColor: cardStyle.borderTopColor, boxShadow: "none" },
          ],
          timing,
        );
        scrim.animate([{ opacity: 1 }, { opacity: 0 }], timing);
        await move.finished;
        // Same task as close(): no frame shows between the two.
        ghost.remove();
      }
      dialog!.close();
      panel.style.opacity = "";
      scrim.getAnimations().forEach((a) => a.cancel());
      body.replaceChildren();
      busy = false;
    }

    // Closing goes back through history when the modal added an entry, so
    // the URL returns to the homepage; popstate then runs close().
    function requestClose() {
      if (busy || !dialog!.open) return;
      if (history.state?.caseModal !== undefined) history.back();
      else {
        close();
        history.replaceState(null, "", homeUrl);
      }
    }

    document.querySelectorAll<HTMLAnchorElement>("[data-case]").forEach((card) =>
      card.addEventListener("click", (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        event.preventDefault();
        open(card, Number(card.dataset.case), card.href);
      }),
    );

    dialog.querySelector(".close")!.addEventListener("click", requestClose);
    // Escape: let history drive the (animated) close.
    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      requestClose();
    });
    // A click outside the panel closes it.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog || event.target === scrim) requestClose();
    });
    window.addEventListener("popstate", () => {
      if (history.state?.caseModal === undefined) close();
    });

    // Scrolling on past the end of the modal closes it, and the deck takes
    // the scroll from there. A fresh gesture at the end closes after a short
    // pull; the momentum of the scroll that reached the end needs a longer
    // one, so a flick to the bottom doesn't close it by accident.
    const atEnd = () =>
      dialog!.scrollTop + dialog!.clientHeight >= dialog!.scrollHeight - 2;
    let lastWheel = 0;
    let fresh = false;
    let pull = 0;
    dialog.addEventListener(
      "wheel",
      (event) => {
        const now = performance.now();
        const gap = now - lastWheel;
        lastWheel = now;
        if (busy || event.deltaY <= 0 || !atEnd()) {
          fresh = false;
          pull = 0;
          return;
        }
        if (gap > 150) fresh = true;
        pull += event.deltaMode === 1 ? event.deltaY * 16 : event.deltaY;
        if (pull > (fresh ? 120 : 600)) {
          pull = 0;
          requestClose();
        }
      },
      { passive: true },
    );

    let touchY: number | null = null;
    dialog.addEventListener(
      "touchstart",
      (event) => {
        touchY = atEnd() ? event.touches[0].clientY : null;
      },
      { passive: true },
    );
    dialog.addEventListener(
      "touchmove",
      (event) => {
        if (touchY === null || busy) return;
        if (touchY - event.touches[0].clientY > 80) {
          touchY = null;
          requestClose();
        }
      },
      { passive: true },
    );
  }

  const decks = [...document.querySelectorAll<HTMLElement>(".deck")].map(init);
  initModal(decks[0]);
</script>

<style>
  body {
    margin: 0;
    background-color: var(--color-bg);
    color: var(--color-body-primary);
    font-family: sans-serif;
    font-size: 1.12em;
    line-height: 28px;
  }

  /* Cards fill the viewport inside a margin, leaving room on the left for
     the numeric indicator. Phones: a smaller margin and no indicator. */
  .deck {
    position: relative;
    z-index: 1;
    --margin: 64px;
    --indicator-w: 15px;
    --left: calc(2 * var(--margin) + var(--indicator-w));
  }

  /* The modal holds a copy of the card while it morphs, so it needs the
     card background too. */
  .deck,
  .case-modal {
    --card-bg: #fff;
  }

  @media (prefers-color-scheme: dark) {
    .deck,
    .case-modal {
      --card-bg: var(--color-bg);
    }
  }

  @media only screen and (max-width: 700px) {
    .deck {
      --margin: 24px;
      --left: var(--margin);
    }
  }

  /* Without the scroll effect (no JS, or reduced motion) the cards are a
     plain column, each one viewport tall. */
  .stage {
    display: flex;
    flex-direction: column;
    gap: var(--margin);
    padding: var(--margin);
    padding-left: var(--left);
  }

  .snap {
    display: none;
  }

  .card {
    box-sizing: border-box;
    height: calc(100vh - 2 * var(--margin));
    height: calc(100dvh - 2 * var(--margin));
    background-color: var(--card-bg);
    border: 1px solid var(--color-border);
  }

  .intro {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 64px;
    padding: 64px;
  }

  .intro .content {
    flex: 0 1 60ch;
  }

  .intro p {
    margin-bottom: 0;
    font-size: var(--typography-body);
  }

  .case {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .case:after {
    content: none;
  }

  .case .title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .case h2 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 23px;
    color: var(--color-body-primary);
  }

  .case :global(.arrow) {
    flex: none;
    width: 15px;
    height: 15px;
    color: var(--color-heading);
  }

  .case .image {
    flex: 1;
    min-height: 0;
    border-radius: var(--border-radius);
    background-color: var(--color-border-bg);
    background-image: var(--img);
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
  }

  .case:hover h2,
  .case:focus-visible h2 {
    color: var(--color-heading);
  }

  /* Scroll-driven deck: one viewport of scroll per card, with the cards
     pinned in a sticky stage and moved by the script. */
  .deck.is-stacked {
    position: relative;
    height: calc(var(--count) * 100vh);
    height: calc(var(--count) * 100dvh);
  }

  .is-stacked .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    padding: 0;
    overflow: hidden;
    display: block;
  }

  .is-stacked .card {
    position: absolute;
    top: var(--margin);
    right: var(--margin);
    bottom: var(--margin);
    left: var(--left);
    height: auto;
    transform-origin: center;
    will-change: transform;
  }

  /* Fade the content, not the card, so cards behind never show through. */
  .is-stacked .card > * {
    opacity: var(--fade, 1);
  }

  /* Numeric indicator: left of the cards, not on phones. */
  .indicator {
    display: none;
  }

  @media only screen and (min-width: 701px) {
    .is-stacked .indicator {
      --row: 22px;
      position: absolute;
      top: 50%;
      left: var(--margin);
      width: var(--indicator-w);
      transform: translateY(-50%);
