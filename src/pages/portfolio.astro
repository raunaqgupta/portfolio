---
import { getCollection } from "astro:content";
import Grid from "../components/grid.collection.astro";
import BaseLayout from "../layouts/baseLayout.astro";
import Button from "../components/button.astro";
import ArrowRightIcon from "../assets/icons/arrow-right.svg";
const breadcrumbs = [{ text: "Raunaq Gupta", url: "/" }];
const caseStudies = await getCollection("casestudies", ({ data }) => {
  return data.caseStudy === true;
});
const newCaseStudies = caseStudies.map(({ slug, ...rest }) => ({
  slug: `/case-studies/` + slug,
  ...rest,
}));
---

<BaseLayout title="Portfolio" breadcrumbs={breadcrumbs}>
  <section id="summary">
    <p>
      I'm a design technologist with 10+ years of experience shipping enterprise
      web applications and developer tools across startups and large
      organizations. I complement product teams with expertise in systems
      design, an intuition for designing for developers and simplifying complex
      enterprise workflows.
    </p>
    <p>
      Hire me to complement your product team with an expert in modeling complex
      systems, and 0→1 design & prototyping. Reach out at <a
        href="mailto:mail@raunaqgupta.com">mail@raunaqgupta.com</a
      > for a chat.
    </p>
  </section>
  <section id="resume">
    <h2>Resume</h2>
    <p>
      I'm currently designing products within the Splunk's Observability suite
      at Cisco.
    </p>
    <Button
      label="View Resume"
      url="/resume"
      isLink={true}
      postIcon={ArrowRightIcon}
    />
  </section>
  <section id="case-studies">
    <h2>Case studies</h2>
    <Grid collection={newCaseStudies} />
  </section>
</BaseLayout>
