---
const { theme = "glass", size = "large" } = Astro.props;
---

<article class={`${theme} ${size}`}>
  <slot />
</article>

<style>
  article {
    display: flex;
    flex-direction: row;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: 10px;
  }

  article.flat {
    background: var(--color-bg-1);
    border: 1px solid var(--color-border);
  }

  article.glass {
    -webkit-backdrop-filter: blur(10px) saturate(120%);
    backdrop-filter: blur(10px) saturate(120%);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.12);
  }

  article.small {
    padding: var(--space-1);
    max-height: 150px;
  }

  @media only screen and (max-width: 700px) {
    article {
      flex-direction: column;
    }
  }
</style>
