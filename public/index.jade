div(id="container")

  div(class="ma4")
    p(class="f5 lh-copy") Experience designer and programmer.

    p(class="f5 lh-copy") Previously designed and developed software for network virtualization, team communication and crowdsourced design feedback. Has mentored startups and students in UXD.

    p(class="f5 lh-copy bb b--lightest-blue pb4") Raunaq Gupta has a graduate degree in HCI from Carnegie Mellon University and finished undergraduate studies in Computer Science (Amity University) from India.

  for article, slug in public.posts._data
    a(href="/posts/#{ slug }.html" class="link dim navy")
      div(id="card" class="mw6 bg-white ma2 ba b--lightest-blue pa1")
        img(src="#{ article.thumbnail }" class="db w-100")
