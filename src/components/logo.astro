---
const { mode = "2d", size = "small" } = Astro.props;
import Logo from "../assets/logo.svg";
import Logo3DDark from "@assets/logo.3d.dark.png";
import Logo3DLight from "@assets/logo.3d.light.png";
---

<div class="logo-container">
  <a class="logo-link" href="/">
    {
      mode === "2d" ? (
        <Logo class:list={[size]} />
      ) : (
        <div class:list={["logo-3d", size]}>
          <picture>
            <source
              srcset={Logo3DLight.src}
              media="(prefers-color-scheme: dark)"
            />
            <img src={Logo3DDark.src} alt="Raunaq Gupta" />
          </picture>
        </div>
      )
    }
  </a>
</div>

<style>
  .logo-container {
    display: flex;
    align-items: center;
  }

  .logo-container .logo-link {
    display: inline-flex;
    text-decoration: none;
  }

  .logo-container .logo-link:after {
    content: none;
  }

  .small {
    height: 42px;
    width: 42px;
  }

  .large {
    height: 256px;
    width: 256px;
  }

  .logo-3d img {
    width: 100%;
    height: 100%;
  }
</style>
