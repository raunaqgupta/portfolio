---
import List from "../components/list.mdx.astro";
import BaseLayout from "../layouts/baseLayout.astro";
import ListMdx from "../components/list.mdx.astro";

import { getCollection } from "astro:content";
const blog = await getCollection("blog");
const newBlog = blog
  .map(({ slug, ...rest }) => ({
    slug: `/blog/` + slug,
    ...rest,
  }))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const links = [{ text: "Raunaq Gupta", url: "/" }];
const format = { year: "numeric", month: "long", day: "numeric" };
---

<BaseLayout title="Blog" breadcrumbs={links}>
  <input
    id="blog-search-input"
    type="search"
    name="search"
    placeholder="Search titles"
    autocomplete="off"
  />
  <div id="blog-list">
    <ListMdx>
      {
        newBlog.map((item) => (
          <li>
            <a href={item.slug}>{item.data.title}</a>{" "}
            <div class="date">
              {item.data.date.toLocaleDateString("en-US", format)}
            </div>
          </li>
        ))
      }
    </ListMdx>
  </div>

  <script type="module">
    const input = document.getElementById("blog-search-input");
    const list = document.querySelector("#blog-list ul");
    if (input && list) {
      const items = Array.from(list.querySelectorAll("li"));
      input.addEventListener("input", () => {
        const value = input.value.trim().toLowerCase();
        items.forEach((item) => {
          const text = item.textContent?.toLowerCase() ?? "";
          item.hidden = value && !text.includes(value);
        });
      });
    }
  </script>

  <style>
    input {
      border: 1px solid var(--color-border);
      border-radius: 6px;
      font-size: 1em;
      padding: var(--space-1);
      transition: border-color 150ms ease;
    }

    input:hover {
      border-color: var(--color-highlight);
    }

    input:focus {
      border-color: var(--color-highlight);
      outline: none;
    }

    li .date {
      font-size: 0.5em;
      color: var(--color-body-tertiary);
    }
  </style>
</BaseLayout>
