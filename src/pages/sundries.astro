---
import BaseLayout from "../layouts/baseLayout.astro";
import Card from "../components/card.astro";
const sundries = await Astro.glob("../data/*.sundries.md");
const links = [{ text: "Raunaq Gupta", url: "/" }];
---

<BaseLayout title="Sundries" links={links}>
  {
    sundries
      .sort((a, b) => {
        return b.frontmatter.from - a.frontmatter.from;
      })
      .map((sundry) => (
        <Card title={sundry.frontmatter.title}>
          <sundry.Content />
        </Card>
      ))
  }
</BaseLayout>

<style>
  div.card {
    margin: 0;
    width: 100%;
    max-width: 69ch;
  }
</style>
