---
const { title, links } = Astro.props;
import Breadcrumbs from "../components/breadcrumbs.astro";
---

<html lang="en">
  <head>
    <title>Raunaq Gupta / {title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personal website of Raunaq Gupta" />
    <meta http-equiv="content-type" content="text/html;charset=utf-8" />
  </head>
  <body>
    <header>
      <Breadcrumbs links={links} />
      <h1>{title}</h1>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Urbanist";
    src: local("Urbanist"), url("/fonts/Urbanist-VariableFont_wght.ttf");
    font-display: swap;
  }

  @font-face {
    font-family: "DMSerifDisplay";
    src: local("DMSerifDisplay"), url("/fonts/DMSerifDisplay-Italic.ttf");
    font-display: swap;
  }

  body {
    margin: 0;
    padding: 4em 8em;
    font-size: 18px;
    line-height: 28px;
    font-family: "Manrope", sans-serif;
    max-width: 69ch;
    background-color: #f6f6f6;
    color: #333;
  }

  section {
    margin-bottom: 4em;
  }

  h1 {
    margin-top: 0.25em;
    font-weight: 200;
    font-family: "DMSerifDisplay";
  }

  h2 {
    margin-top: 2em;
    font-weight: 200;
    font-size: 1.2em;
  }

  h3 {
    margin-bottom: 0;
  }

  img {
    width: 100%;
    border: 1px solid #ccc;
    border-radius: 6px;
  }

  time {
    color: #666;
  }

  ul {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    padding-inline-start: 0;
    gap: 4px;
  }

  a {
    display: inline;
    text-decoration: none;
    padding-bottom: 2px;
    box-sizing: border-box;
    border-bottom: 1px solid #ccc;
    color: rgb(0, 0, 0);
  }

  a.muted {
    color: #999;
    border-bottom-color: transparent;
  }

  a:hover {
    border-bottom-width: 2px;
    border-bottom-color: #000;
    transition: border -bottom-width ease-out 100ms,
      border-bottom-color ease-in 50ms;
  }

  a.muted:hover {
    border-bottom-width: 0;
  }

  @media only screen and (max-width: 1024px) {
    body {
      padding: 4em;
    }
  }

  @media only screen and (max-width: 700px) {
    body {
      padding: 2em;
    }
  }
</style>
