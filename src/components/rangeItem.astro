---
const { title, from, to } = Astro.props;
---

<section>
  <h3>{title}</h3>
  <div>
    <time datetime={from}>{from}</time> - {
      to ? (
        <time datetime={to}>{to}</time>
      ) : (
        <time datetime={new Date().getFullYear().toString()}>
          {new Date().getFullYear()}
        </time>
      )
    }
  </div>
  <slot />
</section>
