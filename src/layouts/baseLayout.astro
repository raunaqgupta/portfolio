---
const { title } = Astro.props;
---

<html>
  <head>
    <title>{title}</title>
    <!-- <meta name="viewport" content="width=device-width, initial-scale=1" /> -->
  </head>
  <body>
    <header>
      <h1><a href="/">Raunaq Gupta</a> / {title}</h1>
    </header>
    <slot />
  </body>
</html>

<style>
  @font-face {
    font-family: "Manrope";
    src: local("Manrope"), url("./fonts/Manrope-Regular.woff2");
  }

  @font-face {
    font-family: "Manrope";
    font-weight: bold;
    src: local("Manrope"), url("./fonts/Manrope-Bold.woff2");
  }

  body {
    margin: 0;
    padding: 4em;
    font-size: 16px;
    font-family: "Manrope", sans-serif;
    max-width: 69ch;
  }
</style>
