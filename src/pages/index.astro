---
import { getCollection } from "astro:content";
import LogoRing from "@components/logoRing.astro";
import ChevronUpIcon from "@icons/chevron-up.svg";
import ChevronDownIcon from "@icons/chevron-down.svg";
import ThickArrowRightIcon from "@icons/thick-arrow-right.svg";
import BaseLayout from "../layouts/baseLayout.astro";
import { ROUTES, SITE_URL } from "../constants";

const description =
  "Personal website of Raunaq Gupta - Design technologist with 10+ years of experience shipping enterprise web applications and developer tools.";

let caseStudies: Awaited<ReturnType<typeof getCollection<"articles">>> = [];
try {
  caseStudies = await getCollection("articles", ({ data }) => {
    return data.published !== false && data.category === "portfolio";
  });
} catch (error) {
  console.error("Error fetching case studies:", error);
}

const cards = caseStudies
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map(({ id, data }) => ({
    href: `${ROUTES.PORTFOLIO}/${id}`,
    title: data.title,
    image: data.thumbnail ?? data.hero,
  }));
---

<BaseLayout title="Home" description={description} canonicalUrl={SITE_URL}>
  <body>
    <main class="deck" style={`--count: ${cards.length + 1};`}>
      <div class="stage">
        <section class="card intro" data-card>
          <LogoRing />
          <div class="content">
            <h1>Hi, I'm Raunaq</h1>
            <p>
              If you are interested in hiring me, visit my <a
                href={ROUTES.PORTFOLIO}>portfolio</a
              >. Check out my <a href={ROUTES.BLOG}>blog</a>, and <a
                href="https://raunaqgupta.substack.com/notes">Substack notes</a
              > where I write about experiments in technology & design, recipes,
              and literature. I'm machine readable at <a
                href="/raunaq-gupta.json">raunaq-gupta.json</a
              >.
            </p>
          </div>
        </section>
        {
          cards.map((card) => (
            <a
              class="card case no-decoration no-hover"
              href={card.href}
              data-card
            >
              <h2>{card.title}</h2>
              <div class="image" style={`--img: url("${card.image}")`} />
            </a>
          ))
        }
        <nav class="indicator" aria-label="Cards">
          <button class="step" type="button" data-step="-1" aria-label="Previous card">
            <ChevronUpIcon class="chevron" />
          </button>
          <div class="window">
            <span class="pointer" aria-hidden="true">
              <ThickArrowRightIcon />
            </span>
            <ol class="numbers">
              <li class="dot" aria-hidden="true" />
              {
                Array.from({ length: cards.length + 1 }, (_, i) => (
                  <li>
                    <button type="button" data-goto={i} aria-label={`Card ${i + 1}`}>
                      {i + 1}
                    </button>
                  </li>
                ))
              }
              <li class="dot" aria-hidden="true" />
            </ol>
          </div>
          <button class="step" type="button" data-step="1" aria-label="Next card">
            <ChevronDownIcon class="chevron" />
          </button>
        </nav>
      </div>
      {
        Array.from({ length: cards.length + 1 }, (_, i) => (
          <div
            class="snap"
            style={`--i: ${i};`}
            aria-hidden="true"
          />
        ))
      }
    </main>
  </body>
</BaseLayout>

<script>
  // Scroll-driven card deck. Keyframes come from three design frames
  // (1280×832): a card resting in the centre, the next card halfway in, and
  // the next card resting while the previous one recedes behind it.
  //
  // For each card, d = its index minus the scroll position (in cards):
  //   d = 1    just below the viewport
  //   d = 0.5  incoming: top at 417/832 of the viewport, opacity 0.75
  //   d = 0    resting in the centre
  //   d = -0.5 outgoing: 88/832 above centre, opacity 0.75
  //   d = -1   receded: scale 0.845, opacity 0.5, its top 58/832 above the
  //            top of the card now resting in front of it
  //   d = -2   one level further back: scaled and lifted again, opacity 0.25
  //   d = -3   gone; at most BACK_DEPTH cards show behind the resting one
  const FRAME_H = 832;
  const IN_MID_TOP = 417 / FRAME_H;
  const OUT_MID = 88 / FRAME_H;
  const PEEK = 58 / FRAME_H;
  const BACK_SCALE = 0.845;
  const BACK_DEPTH = 2;

  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const ease = (t: number) => t * t * (3 - 2 * t);

  function init(deck: HTMLElement) {
    const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");
    const cards = [...deck.querySelectorAll<HTMLElement>("[data-card]")];
    let heights: number[] = [];
    let viewport = 0;
    let frame = 0;

    const indicator = deck.querySelector<HTMLElement>(".indicator")!;
    const numbers = [...indicator.querySelectorAll<HTMLElement>(".numbers li")];
    const goto = [...indicator.querySelectorAll<HTMLButtonElement>("[data-goto]")];
    const steps = [...indicator.querySelectorAll<HTMLButtonElement>("[data-step]")];
    let current = -1;

    function scrollToCard(i: number) {
      const index = Math.min(Math.max(i, 0), cards.length - 1);
      const y = window.scrollY + deck.getBoundingClientRect().top + index * viewport;
      window.scrollTo({ top: y, behavior: "smooth" });
    }

    // A click anywhere on a card behind the resting one (including Enter on
    // a link inside it) scrolls that card to the front instead.
    cards.forEach((card, i) =>
      card.addEventListener("click", (event) => {
        if (!card.hasAttribute("data-behind")) return;
        event.preventDefault();
        scrollToCard(i);
      }),
    );

    goto.forEach((button) =>
      button.addEventListener("click", () => scrollToCard(Number(button.dataset.goto))),
    );
    steps.forEach((button) =>
      button.addEventListener("click", () =>
        scrollToCard(Math.max(current, 0) + Number(button.dataset.step)),
      ),
    );

    // The number column rolls with the scroll position: the current number
    // sits beside the pointer, its neighbours fade above and below it.
    function renderIndicator(p: number) {
      indicator.style.setProperty("--p", String(p));
      numbers.forEach((item, j) => {
        // Item 0 is the dot before the first card.
        const distance = Math.abs(j - 1 - p);
        item.style.opacity = String(Math.max(0, 1 - Math.max(distance - 1, 0) * 2));
        item.classList.toggle("is-current", distance < 0.5);
      });
      const index = Math.round(p);
      if (index === current) return;
      current = index;
      goto.forEach((button, i) => {
        if (i === index) button.setAttribute("aria-current", "step");
        else button.removeAttribute("aria-current");
        // Only the numbers in view can take focus.
        button.tabIndex = Math.abs(i - index) <= 1 ? 0 : -1;
      });
      steps[0].disabled = index <= 0;
      steps[1].disabled = index >= cards.length - 1;
    }

    function measure() {
      viewport = deck.querySelector<HTMLElement>(".stage")!.clientHeight;
      // offsetHeight ignores transforms, so this is the card's own height.
      heights = cards.map((card) => card.offsetHeight);
    }

    function render() {
      frame = 0;
      const H = viewport;
      const top = deck.getBoundingClientRect().top;
      const p = Math.min(Math.max(-top / H, 0), cards.length - 1);

      renderIndicator(p);

      const layout = cards.map((_, i) => {
        const d = i - p;
        const h = heights[i];
        let y = 0;
        let scale = 1;
        let opacity = 1;

        if (d >= 1) {
          y = H / 2 + h / 2;
          opacity = 0;
        } else if (d > 0) {
          const start = H / 2 + h / 2;
          const mid = IN_MID_TOP * H + h / 2 - H / 2;
          if (d > 0.5) {
            const t = ease((d - 0.5) / 0.5);
            y = lerp(mid, start, t);
            opacity = lerp(0.75, 0.5, t);
          } else {
            const t = ease(d / 0.5);
            y = lerp(0, mid, t);
            opacity = lerp(1, 0.75, t);
          }
        } else if (d < 0) {
          // Resting place k levels back: k peeks above the top of the card
          // resting in front at that point, scaled down once per level.
          const backAt = (k: number) => {
            const front = heights[i + k] ?? h;
            const s = BACK_SCALE ** k;
            const top = H / 2 - front / 2 - k * PEEK * H;
            return { y: top + (s * h) / 2 - H / 2, scale: s, opacity: 0.5 ** k };
          };
          const a = -d;
          if (a <= 0.5) {
            const t = ease(a / 0.5);
            y = lerp(0, -OUT_MID * H, t);
            opacity = lerp(1, 0.75, t);
          } else if (a <= 1) {
            const t = ease((a - 0.5) / 0.5);
            const back = backAt(1);
            y = lerp(-OUT_MID * H, back.y, t);
            scale = lerp(1, back.scale, t);
            opacity = lerp(0.75, back.opacity, t);
          } else {
            const k = Math.min(Math.floor(a), BACK_DEPTH);
            const t = ease(Math.min(a - k, 1));
            const from = backAt(k);
            const to = backAt(k + 1);
            y = lerp(from.y, to.y, t);
            scale = lerp(from.scale, to.scale, t);
            // Past the last visible level, fade out instead.
            opacity = lerp(from.opacity, k < BACK_DEPTH ? to.opacity : 0, t);
          }
        }

        return { d, y, scale, opacity, bottom: y + (scale * h) / 2 };
      });

      // A card behind a shorter one would show below it: cut each card off
      // at the visible bottom edge of the card in front, front to back.
      let limit = Infinity;
      for (let i = cards.length - 1; i >= 0; i--) {
        const card = cards[i];
        const { d, y, scale, opacity, bottom } = layout[i];
        const overhang = Math.max(bottom - limit + 2, 0) / scale;
        if (opacity > 0) limit = Math.min(limit, bottom);

        card.style.transform = `translate(-50%, -50%) translateY(${y}px) scale(${scale})`;
        card.style.clipPath = overhang ? `inset(0 0 ${overhang}px 0)` : "";
        card.style.setProperty("--fade", String(opacity));
        card.style.visibility = opacity <= 0 ? "hidden" : "visible";
        card.style.zIndex = String(i + 1);
        // Cards still coming in can't be used yet. Cards behind the resting
        // one are a single target: clicking one brings it to the front.
        card.inert = d >= 0.5 || opacity <= 0;
        card.toggleAttribute("data-behind", d <= -0.5);
      }
    }

    function schedule() {
      if (!frame) frame = requestAnimationFrame(render);
    }

    function apply() {
      if (motion.matches) {
        deck.classList.add("is-stacked");
        measure();
        render();
      } else {
        deck.classList.remove("is-stacked");
        cards.forEach((card) => {
          card.removeAttribute("style");
          card.removeAttribute("data-behind");
          card.inert = false;
        });
      }
    }

    window.addEventListener("scroll", () => motion.matches && schedule(), {
      passive: true,
    });
    window.addEventListener("resize", () => {
      if (!motion.matches) return;
      measure();
      schedule();
    });
    motion.addEventListener("change", apply);
    apply();
  }

  document.querySelectorAll<HTMLElement>(".deck").forEach(init);
</script>

<style>
  body {
    margin: 0;
    background-color: var(--color-bg);
    color: var(--color-body-primary);
    font-family: sans-serif;
    font-size: 1.12em;
    line-height: 28px;
  }

  /* Without the scroll effect (no JS, or reduced motion) the cards are a
     plain column. */
  .deck {
    --gutter: 16px;
    --case-w: min(961px, calc(100vw - 2 * var(--gutter)));
    --intro-w: min(800px, calc(100vw - 2 * var(--gutter)));
  }

  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
    padding: 64px var(--gutter);
  }

  .snap {
    display: none;
  }

  .card {
    box-sizing: border-box;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .intro {
    width: var(--intro-w);
    min-height: 400px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 64px;
    padding: 48px 64px;
  }

  .intro .content {
    flex: 1;
  }

  .intro p {
    margin-bottom: 0;
  }

  .case {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: var(--case-w);
    padding: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .case:after {
    content: none;
  }

  .case h2 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--color-body-primary);
  }

  .case .image {
    width: 100%;
    aspect-ratio: 911 / 499;
    background-color: var(--color-border-bg);
    background-image: var(--img);
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
  }

  .case:hover h2,
  .case:focus-visible h2 {
    color: var(--color-heading);
  }

  /* Scroll-driven deck: one viewport of scroll per card, with the cards
     pinned in a sticky stage and positioned by the script. */
  .deck.is-stacked {
    --peek: calc(58 / 832 * 100dvh);
    /* Keep a case card (image + title row) inside the viewport. */
    --case-w: min(
      961px,
      calc(100vw - 2 * var(--gutter)),
      calc((100dvh - 4 * var(--peek) - 72px) * 911 / 499 + 48px)
    );
    position: relative;
    height: calc(var(--count) * 100vh);
    height: calc(var(--count) * 100dvh);
  }

  .is-stacked .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    padding: 0;
    overflow: hidden;
    display: block;
  }

  .is-stacked .card {
    position: absolute;
    top: 50%;
    left: 50%;
    transform-origin: center;
    will-change: transform;
  }

  /* Numeric indicator: desktop only, to the left of the case cards. */
  .indicator {
    display: none;
  }

  @media only screen and (min-width: 1200px) {
    .is-stacked .indicator {
      --row: 22px;
      position: absolute;
      top: 50%;
      right: calc(50% + var(--case-w) / 2 + 72px);
      transform: translateY(-50%);
      z-index: 100;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      font-size: 13px;
      line-height: var(--row);
      font-variant-numeric: tabular-nums;
      color: var(--color-body-tertiary);
    }
  }

  .indicator button {
    all: unset;
    cursor: pointer;
    display: block;
  }

  .indicator button:focus-visible {
    outline: 2px solid var(--color-highlight);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .indicator .step {
    display: flex;
    justify-content: center;
    width: 15px;
    height: 16px;
    align-items: center;
    color: var(--color-body-primary);
  }

  .indicator .step:disabled {
    color: var(--color-border);
    cursor: default;
  }

  .indicator .step:not(:disabled):hover {
    color: var(--color-heading);
  }

  .step :global(.chevron) {
    width: 15px;
    height: 15px;
  }

  /* Shows three rows: previous, current, next. */
  .window {
    position: relative;
    height: calc(3 * var(--row));
    overflow: hidden;
    padding-left: 24px;
  }

  .pointer {
    position: absolute;
    left: 0;
    top: var(--row);
    height: var(--row);
    display: flex;
    align-items: center;
    color: var(--color-heading);
  }

  .numbers {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 15px;
    text-align: center;
    /* Item 1 (card 1) sits in the middle row when p = 0. */
    transform: translateY(calc(var(--p, 0) * -1 * var(--row)));
  }

  .numbers li {
    height: var(--row);
    margin: 0;
  }

  .numbers button {
    width: 100%;
  }

  .numbers button:hover,
  .numbers .is-current button {
    color: var(--color-heading);
  }

  .numbers .dot {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .numbers .dot::before {
    content: "";
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: var(--color-body-tertiary);
  }

  /* A card behind the resting one acts as one button that brings it
     forward. */
  .is-stacked .card[data-behind] {
    cursor: pointer;
  }

  .is-stacked .card[data-behind] * {
    pointer-events: none;
  }

  .is-stacked .card[data-behind]:hover > * {
    opacity: calc(var(--fade, 1) + 0.2);
  }

  /* Fade the content, not the card, so cards behind never show through. */
  .is-stacked .card > * {
    opacity: var(--fade, 1);
  }

  /* One snap point per card, at the scroll position where it rests. */
  .is-stacked .snap {
    display: block;
    position: absolute;
    left: 0;
    top: calc(var(--i) * 100dvh);
    width: 1px;
    height: 100dvh;
    scroll-snap-align: start;
    pointer-events: none;
  }

  :global(html):has(.deck.is-stacked) {
    scroll-snap-type: y proximity;
  }

  @media only screen and (max-width: 700px) {
    .intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
      padding: 32px 24px;
      min-height: 0;
    }

    .case {
      gap: var(--space-2);
      padding: var(--space-2);
    }

    .case h2 {
      font-size: 1rem;
    }
  }
</style>
