---
// A select fixed at the top centre of the home page that names the section
// in view and jumps to another one. Each option's value is the id of a
// section on the page. Picking one scrolls there; scrolling moves the
// selection to the section that covers the middle of the viewport.
//
// A section can hold an element with `data-page-target` to scroll to instead
// of its own top, such as the resume sheet; that element's scroll-margin-top
// is kept clear above it.
import Select from "exo-ds/select";

interface Props {
  pages: Array<{ id: string; label: string }>;
}

const { pages } = Astro.props;
const options = pages.map(({ id, label }) => ({ value: id, label }));
---

<nav class="page-select" aria-label="Pages">
  <Select size="sm" options={options} defaultValue={pages[0]?.id} aria-label="Go to page" />
</nav>

<script>
  const nav = document.querySelector<HTMLElement>(".page-select");
  const select = nav?.querySelector("select");

  if (nav && select) {
    const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");
    const sections = [...select.options]
      .map((option) => document.getElementById(option.value))
      .filter((section): section is HTMLElement => section !== null);

    const docTop = (el: Element) => el.getBoundingClientRect().top + window.scrollY;

    // While a picked section is being scrolled to, the selection stays on it
    // rather than naming each section the page passes on the way.
    let jumping = false;
    let frame = 0;

    function update() {
      frame = 0;
      if (jumping) return;
      const middle = window.scrollY + window.innerHeight / 2;
      let current = sections[0];
      for (const section of sections) {
        if (docTop(section) <= middle) current = section;
      }
      if (current && select!.value !== current.id) select!.value = current.id;
    }

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    function settle() {
      jumping = false;
      schedule();
    }

    select.addEventListener("change", () => {
      const section = document.getElementById(select.value);
      if (!section) return;
      const target = section.querySelector<HTMLElement>("[data-page-target]") ?? section;
      const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
      const top = section === sections[0] ? 0 : Math.max(0, docTop(target) - margin);
      const smooth = motion.matches;
      jumping = smooth;
      window.scrollTo({ top, behavior: smooth ? "smooth" : "auto" });
      if (smooth) {
        // scrollend isn't in every browser yet; stop waiting after a while.
        window.addEventListener("scrollend", settle, { once: true });
        setTimeout(settle, 1500);
      }
    });

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    update();
  }
</script>

<style>
  .page-select {
    position: fixed;
    top: 24px;
    left: 50%;
    z-index: 10;
    translate: -50% 0;
    /* exo-ds draws the select from these; the site's colours keep it in
       step with dark mode. */
    --exo-color-bg: var(--color-bg);
    --exo-color-text: var(--color-body-primary);
    --exo-color-text-muted: var(--color-body-secondary);
    --exo-color-border-strong: var(--color-border-1);
    --exo-color-accent: var(--color-highlight);
  }

  /* 140px wide, as in the design. */
  .page-select :global(.exo-select) {
    width: 140px;
  }
</style>
