---
import Logo from "@components/logo.astro";

const currentPath = Astro.url.pathname;
---

<header>
  <Logo mode="3d" size="small" />
  <nav>
    <a
      href="/portfolio"
      class:list={[
        { active: currentPath.startsWith("/portfolio") },
        "no-decoration",
      ]}>Portfolio</a
    >
    <a
      href="/resume"
      class:list={[
        { active: currentPath.startsWith("/resume") },
        "no-decoration",
      ]}>Resume</a
    >
    <a
      href="/blog"
      class:list={[
        { active: currentPath.startsWith("/blog") },
        "no-decoration",
      ]}>Blog</a
    >
  </nav>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 0 var(--space-4);
    border-bottom: 1px solid var(--color-border-bg);
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media only screen and (max-width: 700px) {
    nav a {
      font-size: var(--typography-body-small);
    }
  }
</style>
