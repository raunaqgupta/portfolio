---
const { label, url, isLink, isDownload } = Astro.props;
---

{
  isLink ? (
    <a class="button" href={url} {...(isDownload ? { download: true } : {})}>
      {label}
    </a>
  ) : (
    <button onclick={url}>{label}</button>
  )
}

<style>
  button,
  a.button {
    text-decoration: none;
    font-size: 0.8em;
    display: inline-block;
    cursor: pointer;
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-2);
    border-radius: 4px;
  }

  button:hover,
  a.button:hover {
    border-color: var(--color-highlight);
  }

  a.button:after {
    content: none;
  }
</style>
