---
const { title, from, to } = Astro.props;
---

<article>
  <h3>{title}</h3>
  <p>
    <time datetime={from}>{from}</time> - {
      to ? <time datetime={to}>{to}</time> : <span>Now</span>
    }
  </p>
  <p>
    Research and design of various product features pertaining to Cisco's
    AppDynamics division.
  </p>
  <p>
    Active projects include improving overall product navigation experience, and
    exposing Trace data via the OpenTelemetry specification.
  </p>
</article>
