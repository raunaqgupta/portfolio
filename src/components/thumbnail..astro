---
const { image, title, description, url } = Astro.props;
import Card from "./card.astro";
---

<a href={url}>
  <Card>
    <img src={image} />
    <div>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
  </Card>
</a>

<style>
  a {
    text-decoration: none;
  }

  a:after {
    content: none;
  }

  img {
    width: 100%;
    max-width: 400px;
    border: 1px solid #ccc;
    border-radius: 6px;
  }

  h2 {
    margin: 0;
    font-size: 1em;
    color: var(--color-heading);
  }
</style>
