---
const { collection, isStyled } = Astro.props;
const sortedCollection = [...collection].sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<ul class={isStyled ? "styled" : ""}>
  {
    sortedCollection.map((item) => (
      <li>
        <a href={item.slug}>{item.data.title}</a>
      </li>
    ))
  }
</ul>
