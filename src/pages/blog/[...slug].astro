---
import PageLayout from "@layouts/pageLayout.astro";
import Imgmdx from "@components/img.mdx.astro";
import Codemdx from "@components/Code.mdx.astro";
import Prose from "@components/Prose.astro";
import { getCollection } from "astro:content";
import PostDetails from "@components/PostDetails.astro";
import { formatDate } from "../../utils";
import { SITE_URL } from "../../constants";
import { getDescription } from "../../utils";

export async function getStaticPaths() {
  try {
    const blog = await getCollection("articles", ({ data }) => {
      return data.internal !== true && data.category !== "case-study";
    });
    return blog.map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
  } catch (error) {
    console.error("Error generating blog paths:", error);
    return [];
  }
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect("/404");
}

const { Content } = await entry.render();

const description =
  entry.data.description || getDescription(undefined, entry.body);
const canonicalUrl = `${SITE_URL}/blog/${entry.slug}`;
const publishedTime = entry.data.date.toISOString();
---

<PageLayout
  title={entry.data.title}
  description={description}
  type="article"
  publishedTime={publishedTime}
  canonicalUrl={canonicalUrl}
  frontmatter={entry.data}
>
  <Prose><Content components={{ img: Imgmdx, pre: Codemdx }} /></Prose>
  <PostDetails>
    <div class="date">
      {formatDate(entry.data.date)}
    </div>
    <div class="separator">-</div>
    <div class="category">
      {entry.data.category}
    </div>
  </PostDetails>
</PageLayout>

<style>
  .date,
  .separator,
  .category {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .category {
    text-transform: capitalize;
  }
</style>
