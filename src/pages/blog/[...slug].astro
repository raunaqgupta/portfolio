---
import NarrowLayout from "@layouts/NarrowLayout.astro";
import Imgmdx from "@components/img.mdx.astro";
import Codemdx from "@components/Code.mdx.astro";
import Prose from "@components/Prose.astro";
import { getCollection, render } from "astro:content";
import { SITE_URL } from "../../constants";
import { getDescription } from "../../utils";

export async function getStaticPaths() {
  try {
    const blog = await getCollection("articles", ({ data }) => {
      return data.internal !== true && data.category !== "portfolio";
    });
    return blog.map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
  } catch (error) {
    console.error("Error generating blog paths:", error);
    return [];
  }
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect("/404");
}

const { Content } = await render(entry);

const description =
  entry.data.description || getDescription(undefined, entry.body);
const canonicalUrl = `${SITE_URL}/blog/${entry.id}`;
const publishedTime = entry.data.date.toISOString();
---

<NarrowLayout
  title={entry.data.title}
  description={description}
  type="article"
  publishedTime={publishedTime}
  canonicalUrl={canonicalUrl}
  frontmatter={entry.data}
>
  <Prose><Content components={{ img: Imgmdx, pre: Codemdx }} /></Prose>
</NarrowLayout>

<style>
  .date,
  .separator,
  .category {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .category {
    text-transform: capitalize;
  }
</style>
