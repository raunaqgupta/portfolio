---
const { mode = "2d", size = "small" } = Astro.props;
import Logo from "../assets/logo.svg";

const SIZES = { small: 42, large: 128 };
const px = SIZES[size as keyof typeof SIZES];
---

<div class="logo-container">
  <a class="no-decoration no-hover logo-link" href="/">
    {
      mode === "2d" ? (
        <Logo class:list={[size]} />
      ) : (
        <canvas
          class:list={["logo-3d", size]}
          width={px}
          height={px}
          role="img"
          aria-label="Raunaq Gupta"
        />
      )
    }
  </a>
</div>

<script>
  import Zdog from "zdog";
  import { addLogo, themeColors, onSchemeChange } from "./zdog/logo";

  // The 3D logo, drawn with Zdog. It sits in a link, so it isn't draggable;
  // it just turns a little towards the pointer while hovered.
  document.querySelectorAll<HTMLCanvasElement>("canvas.logo-3d").forEach((canvas) => {
    const illo = new Zdog.Illustration({ element: canvas });
    const logo = addLogo(illo, illo.width / 2);
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    const paint = () => {
      logo.setColors(themeColors(canvas));
      illo.updateRenderGraph();
    };
    paint();
    onSchemeChange(paint);

    canvas.addEventListener("pointermove", (event) => {
      if (reduceMotion.matches) return;
      const rect = canvas.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      logo.surface.rotate.set({ x: -y * 0.6, y: -x * 0.6 });
      illo.updateRenderGraph();
    });
    canvas.addEventListener("pointerleave", () => {
      logo.surface.rotate.set({});
      illo.updateRenderGraph();
    });
  });
</script>

<style>
  .logo-container {
    display: flex;
    align-items: center;
  }

  .logo-container .logo-link {
    display: inline-flex;
    text-decoration: none;
  }

  .logo-container .logo-link:after {
    content: none;
  }

  .small {
    height: 42px;
    width: 42px;
  }

  .large {
    height: 128px;
    width: 128px;
  }

  .logo-3d {
    display: block;
  }
</style>
