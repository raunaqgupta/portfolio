---
import { Recipe } from 'cooklang'
const { recipe } = Astro.props
const newRecipe = new Recipe(recipe)
---

<ul class='meta'>
  {
    newRecipe.metadata.map((metadatum) => (
      <li class="property">{metadatum.key}: {metadatum.value}</li>
    ))
  }
</ul>

<h2>Ingredients</h2>

<ul class='ingredients'>
  {
    newRecipe.ingredients.map((ingredient) => (
      <li>{ingredient.amount} {ingredient.units} {ingredient.name}</li>
    ))
  }
</ul>

<h2>Instructions</h2>

<ul class="instructions">
  {
    newRecipe.steps.map((step) => (
      <li>
        {
          step.line.map((token) => (
            typeof token === 'string'
            ? <span>{token}</span> : <span>{token.name}</span>
          ))
        }
      </li>
    ))
  }
</ul>

<style>
  .meta, .ingredients {
    gap: 1px;
  }

  .property {
    text-transform: capitalize;
  }

  .instructions {
    list-style: decimal;
    padding-inline-start: 24px;
  }
</style>
