---
import BaseLayout from "../layouts/baseLayout.astro";
import RangeItem from "../components/rangeItem.astro";
import UlMdx from "../components/ul.mdx.astro";

import { getCollection } from "astro:content";
const rawJobs = await getCollection("jobs");
const jobs = await Promise.all(
  rawJobs.map(async (job) => {
    const rendered = await job.render();
    return { ...job, Content: rendered.Content };
  })
);

const education = await getCollection("education");
const links = [{ text: "Raunaq Gupta", url: "/" }];
---

<BaseLayout title="Resume" links={links}>
  <section id="summary">
    <h2>TL;DR</h2>
    <p>
      I have a decade+ experience in shipping web applications from
      conceptualization, design to UI development. I bring deep expertise in
      systems design, an intuitive sense for building developer tools and
      simplifying complex enterprise software across multiple startups and large
      organizations.
    </p>
    <p>
      If you want to complement your product team with a system thinker,
      designer, prototyper, and UI engineer, email me at <a
        href="mailto:mail@raunaqgupta.com">mail@raunaqgupta.com</a
      >.
    </p>
  </section>
  <section id="work-experience">
    <h2>Work experience</h2>
    {
      jobs
        .sort((a, b) => {
          return b.data.from.getFullYear() - a.data.from.getFullYear();
        })
        .map((job) => (
          <RangeItem
            title={job.data.role}
            org={job.data.organization}
            from={job.data.from}
            to={job.data.to}
          >
            <job.Content components={{ ul: UlMdx }} />
          </RangeItem>
        ))
    }
  </section>
  <section id="education">
    <h2>Education</h2>
    {
      education
        .sort((a, b) => {
          return b.data.from - a.data.from;
        })
        .map((item) => (
          <RangeItem
            title={item.data.role}
            org={item.data.organization}
            from={item.data.from}
            to={item.data.to}
          >
            {/* <item.Content /> */}
          </RangeItem>
        ))
    }
  </section>
</BaseLayout>
