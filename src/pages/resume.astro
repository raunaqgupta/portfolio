---
import BaseLayout from "../layouts/baseLayout.astro";
import RangeItem from "../components/rangeItem.astro";
import Thumbnail from "../components/thumbnail.astro";
import DownloadIcon from "../assets/icons/download.svg";
import LinkedInIcon from "../assets/icons/linkedin.svg";

import { getCollection } from "astro:content";
import { getEntries } from "astro:content";
const rawJobs = await getCollection("jobs");
const jobs = await Promise.all(
  rawJobs.map(async (job) => {
    const rendered = await job.render();
    const caseStudies = job.data.caseStudies
      ? await getEntries(job.data.caseStudies)
      : [];
    return { ...job, Content: rendered.Content, caseStudies };
  })
);
const sortedJobs = [...jobs].sort(
  (a, b) => b.data.from.getTime() - a.data.from.getTime()
);

const education = await getCollection("education");
const sortedEducation = [...education].sort(
  (a, b) => b.data.from.getTime() - a.data.from.getTime()
);

const breadcrumbs = [
  { text: "Raunaq Gupta", url: "/" },
  { text: "Portfolio", url: "/portfolio" },
];

const actions = [
  {
    label: "LinkedIn",
    url: "https://www.linkedin.com/in/raunaqgupta/",
    isLink: true,
    isExternalLink: true,
    preIcon: LinkedInIcon,
  },
  {
    label: "Download",
    url: "/resume.raunaqgupta.pdf",
    isLink: true,
    isDownload: true,
    postIcon: DownloadIcon,
  },
];
---

<BaseLayout title="Resume" breadcrumbs={breadcrumbs} actions={actions}>
  <section id="experience">
    <h2>Experience</h2>
    {
      sortedJobs.map((job) => (
        <RangeItem
          title={job.data.role}
          org={job.data.organization}
          from={job.data.from}
          to={job.data.to}
        >
          <job.Content />
          {job.caseStudies.length > 0 && (
            <div class="projects">
              {job.caseStudies.map((caseStudy) => (
                <Thumbnail
                  image={caseStudy.data.thumbnail}
                  title={caseStudy.data.title}
                  url={`/case-studies/${caseStudy.slug}`}
                  size="small"
                  theme="flat"
                />
              ))}
            </div>
          )}
        </RangeItem>
      ))
    }
  </section>
  <section id="education">
    <h2>Education</h2>
    {
      sortedEducation.map((item) => (
        <RangeItem
          title={item.data.role}
          org={item.data.organization}
          from={item.data.from}
          to={item.data.to}
        />
      ))
    }
  </section>
</BaseLayout>

<style>
  h2 {
    color: var(--color-heading);
    font-size: 1.2em;
    font-weight: 200;
    margin-top: 2em;
  }

  .projects {
    display: flex;
    flex-direction: row;
    gap: var(--space-2);
  }

  @media only screen and (max-width: 700px) {
    .projects {
      flex-direction: column;
    }
  }
</style>
