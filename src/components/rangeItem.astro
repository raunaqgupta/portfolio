---
const { title, org, from, to } = Astro.props;
---

<section>
  <h3>{title}</h3>
  <div>{org}</div>
  <time datetime={from}>{from}</time> - {
    to ? (
      <time datetime={to}>{to}</time>
    ) : (
      <span>Current</span>
    )
  }
  <div></div>
  <slot />
</section>

<style>
  section {
    margin-bottom: 2em;
  }

  time, span {
    color: #666;
  }
</style>
