---
interface Props {
  src: string;
  title: string;
  height?: number;
  linkLabel?: string;
}

const { src, title, height = 520, linkLabel = "Open in a new tab" } = Astro.props;
---

<figure class="embed">
  <iframe
    src={src}
    title={title}
    height={height}
    loading="lazy"
    allowfullscreen
  ></iframe>
  <figcaption>
    <span class="caption">{title}</span>
    <a href={src} target="_blank" rel="noopener noreferrer">{linkLabel}</a>
  </figcaption>
</figure>

<style>
  .embed {
    margin: var(--space-4) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  iframe {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    background: var(--color-bg);
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--color-body-secondary);
  }

  figcaption a {
    white-space: nowrap;
  }

  /* Interactive embeds are too cramped on narrow screens; link out instead */
  @media only screen and (max-width: 700px) {
    iframe {
      display: none;
    }
  }
</style>
