---
import PageLayout from "../../layouts/pageLayout.astro";
import Imgmdx from "@components/img.mdx.astro";
import Ulmdx from "@components/ul.mdx.astro";
import Listmdx from "@components/list.mdx.astro";
import Hero from "@components/hero.astro";

import { getCollection } from "astro:content";
import { ROUTES, SITE_URL } from "../../constants";
import { getDescription } from "../../utils";

export async function getStaticPaths() {
  try {
    const products = await getCollection("articles", ({ data }) => {
      return data.category === "collection";
    });
    return products.map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
  } catch (error) {
    console.error("Error generating collection paths:", error);
    return [];
  }
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect("/404");
}

const { Content, components } = await entry.render();
const links = [{ text: "Portfolio", url: ROUTES.PORTFOLIO }];

const description = entry.data.description || getDescription(undefined, entry.body);
const canonicalUrl = `${SITE_URL}/collection/${entry.slug}`;
---

<PageLayout
  title={entry.data.title}
  description={description}
  image={entry.data.hero || entry.data.thumbnail}
  canonicalUrl={canonicalUrl}
  breadcrumbs={links}
  frontmatter={entry.data}
>
  <Hero imageUrl={entry.data.hero} aspectRatio={1.5} />
  <Content
    components={{ ...components, img: Imgmdx, ul: Ulmdx, List: Listmdx }}
  />
</PageLayout>
