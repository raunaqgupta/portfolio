---
const initialYear = new Date().getFullYear();
import GitHubIcon from "../assets/icons/github.svg";
import SubstackIcon from "../assets/icons/substack.svg";
---

<footer>
  <small>© <span id="year">{initialYear}</span> Raunaq Gupta</small>
  <div class="links">
    <a
      href="https://raunaqgupta.substack.com"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Substack"
      class="no-decoration no-hover"
    >
      <SubstackIcon />
    </a>
    <a
      href="https://github.com/raunaqgupta"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      class="no-decoration no-hover"
    >
      <GitHubIcon />
    </a>
  </div>
</footer>

<script type="module">
  const el = document.getElementById("year");
  if (el) {
    const current = new Date().getFullYear();
    if (el.textContent !== String(current)) el.textContent = String(current);
  }
</script>

<style>
  footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    color: var(--color-body-tertiary);
    padding: var(--space-2) 0;
    margin-top: var(--space-2);
    border-top: 1px solid var(--color-border-bg);
  }

  footer a {
    text-decoration: none;
    color: var(--color-body-tertiary);
  }

  footer a:after {
    content: none;
  }

  .links {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
  }
</style>
