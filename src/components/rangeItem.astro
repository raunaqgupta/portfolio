---
const { title, org, from, to } = Astro.props;
---

<section>
  <h3>{org}</h3>
  <div>{title}</div>
  <time datetime={from}>{from.getFullYear()}</time> - {
    to ? <time datetime={to}>{to.getFullYear()}</time> : <span>Current</span>
  }
  <slot />
</section>

<style>
  section {
    margin-bottom: 2em;
  }

  h3 {
    font-weight: 600;
    margin-bottom: 0;
  }

  time,
  span {
    color: var(--color-body-secondary);
  }
</style>
