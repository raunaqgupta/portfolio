---
import BaseLayout from "../layouts/baseLayout.astro";
import List from "../components/list.astro";
import { getCollection } from "astro:content";
const blog = await getCollection("blog");
const newBlog = blog.map(({ slug, ...rest }) => ({
  slug: `/blog/` + slug,
  ...rest,
}));
const links = [{ text: "Raunaq Gupta", url: "/" }];
---

<BaseLayout title="Blog" breadcrumbs={links}>
  <input
    id="blog-search-input"
    type="search"
    name="search"
    placeholder="Search titles"
    autocomplete="off"
  />
  <div id="blog-list">
    <List collection={newBlog} />
  </div>

  <script type="module">
    const input = document.getElementById("blog-search-input");
    const list = document.querySelector("#blog-list ul");
    if (input && list) {
      const items = Array.from(list.querySelectorAll("li"));
      input.addEventListener("input", () => {
        const value = input.value.trim().toLowerCase();
        items.forEach((item) => {
          const text = item.textContent?.toLowerCase() ?? "";
          item.hidden = value && !text.includes(value);
        });
      });
    }
  </script>

  <style>
    input {
      border: 1px solid var(--color-border);
      border-radius: 6px;
      font-size: 1em;
      padding: var(--space-1);
      transition: border-color 150ms ease;
    }

    input:hover {
      border-color: var(--color-highlight);
    }

    input:focus {
      border-color: var(--color-highlight);
      outline: none;
    }
  </style>
</BaseLayout>
