---
interface Props {
  aspectRatio: number;
  imageUrl?: string;
}

const { aspectRatio = 3, imageUrl } = Astro.props;
---

<div
  class="hero"
  style={`--aspect-ratio: ${aspectRatio}; --img: url("${imageUrl}")`}
>
  <div></div>
</div>

<style>
  .hero {
    width: 100%;
    aspect-ratio: var(--aspect-ratio);
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--color-border-bg);
  }

  .hero > div {
    width: 100%;
    height: 100%;
    background-image: var(--img);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
</style>
