---
const {
  label,
  url,
  iconOnly = false,
  isLink,
  isExternalLink,
  isDownload,
  Icon,
} = Astro.props;
---

{
  isLink ? (
    <a
      class="button"
      href={url}
      {...(isExternalLink
        ? { target: "_blank", rel: "noopener noreferrer" }
        : {})}
      {...(isDownload ? { download: true } : {})}
    >
      {iconOnly ? "" : label}
      {Icon && <Icon />}
    </a>
  ) : (
    <button onclick={url}>
      {iconOnly ? "" : label}
      {Icon && <Icon />}
    </button>
  )
}

<style>
  button,
  a.button {
    text-decoration: none;
    font-size: 0.8em;
    display: inline-flex;
    flex-direction: row;
    gap: var(--space-1);
    align-items: center;
    cursor: pointer;
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-2);
    border-radius: 4px;
  }

  button:hover,
  a.button:hover {
    border-color: var(--color-highlight);
  }

  a.button:after {
    content: none;
  }

  @media only screen and (max-width: 700px) {
    article {
      flex-direction: column;
    }
  }
</style>
