---
import Logo from "../assets/logo.svg";
---

<div class="logo-container">
  <a class="logo-link" href="/"><Logo class="logo" /></a>
</div>

<style>
  .logo-container {
    display: flex;
    align-items: center;
  }

  .logo-container .logo-link {
    display: inline-flex;
    text-decoration: none;
  }

  .logo-container .logo-link:after {
    content: none;
  }

  .logo-container .logo {
    height: 42px;
    width: 42px;
  }
</style>
