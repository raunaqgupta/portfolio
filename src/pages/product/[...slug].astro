---
import BaseLayout from "../../layouts/baseLayout.astro";
import Imgmdx from "../../components/img.mdx.astro";
import Ulmdx from "../../components/ul.mdx.astro";
import Listmdx from "../../components/list.mdx.astro";

import { getCollection } from "astro:content";
export async function getStaticPaths() {
  const products = await getCollection("product");
  return products.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, components } = await entry.render();
const links = [
  { text: "Raunaq Gupta", url: "/" },
  { text: "Portfolio", url: "/portfolio" },
];
---

<BaseLayout title={entry.data.name} breadcrumbs={links}>
  <div class="image">
    <div style={`--img: url("${entry.data.hero}")`}></div>
  </div>
  <Content
    components={{ ...components, img: Imgmdx, ul: Ulmdx, List: Listmdx }}
  />
</BaseLayout>

<style>
  .image {
    width: 100%;
    aspect-ratio: 3;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--color-border-bg);
  }

  .image > div {
    width: 100%;
    height: 100%;
    background-image: var(--img);
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
  }
</style>
