---
import BaseLayout from "../layouts/baseLayout.astro";
import RangeItem from "../components/rangeItem.astro";
import UlMdx from "../components/ul.mdx.astro";

import { getCollection } from "astro:content";
const rawJobs = await getCollection("jobs");
const jobs = await Promise.all(
  rawJobs.map(async (job) => {
    const rendered = await job.render();
    return { ...job, Content: rendered.Content };
  })
);
const sortedJobs = [...jobs].sort(
  (a, b) => b.data.from.getTime() - a.data.from.getTime()
);

const education = await getCollection("education");
const sortedEducation = [...education].sort(
  (a, b) => b.data.from.getTime() - a.data.from.getTime()
);

const breadcrumbs = [
  { text: "Raunaq Gupta", url: "/" },
  { text: "Portfolio", url: "/portfolio" },
];

const actions = [
  {
    label: "Download",
    url: "/resume.raunaqgupta.pdf",
    isLink: true,
    isDownload: true,
    icon: "download",
  },
];
---

<BaseLayout title="Resume" breadcrumbs={breadcrumbs} actions={actions}>
  <section id="experience">
    <h2>Experience</h2>
    {
      sortedJobs.map((job) => (
        <RangeItem
          title={job.data.role}
          org={job.data.organization}
          from={job.data.from}
          to={job.data.to}
        >
          <job.Content components={{ ul: UlMdx }} />
        </RangeItem>
      ))
    }
  </section>
  <section id="education">
    <h2>Education</h2>
    {
      sortedEducation.map((item) => (
        <RangeItem
          title={item.data.role}
          org={item.data.organization}
          from={item.data.from}
          to={item.data.to}
        >
          {/* <item.Content /> */}
        </RangeItem>
      ))
    }
  </section>
</BaseLayout>
