---
import PageLayout from "@layouts/pageLayout.astro";
import Imgmdx from "@components/img.mdx.astro";
import Ulmdx from "@components/ul.mdx.astro";
import Listmdx from "@components/list.mdx.astro";
import Hero from "@components/hero.astro";

import { getCollection } from "astro:content";
import { ROUTES, SITE_URL } from "../../constants";
import { getDescription } from "../../utils";

export async function getStaticPaths() {
  try {
    const projects = await getCollection("articles", ({ data }) => {
      return data.category === "case-study";
    });
    return projects.map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
  } catch (error) {
    console.error("Error generating case study paths:", error);
    return [];
  }
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect("/404");
}

let collectionArticle = null;
if (entry.data.collection) {
  try {
    const allArticles = await getCollection("articles");
    collectionArticle = allArticles.find(
      (article) => article.slug === entry.data.collection,
    ) || null;
  } catch (error) {
    console.error("Error fetching collection article:", error);
  }
}

const { Content, components } = await entry.render();

const links = [
  {
    text: "Portfolio",
    url: ROUTES.PORTFOLIO,
  },
  {
    text: `Collection: ${collectionArticle?.data.title || entry.data.collection || "Unknown"}`,
    url: collectionArticle ? `/collection/${entry.data.collection}` : ROUTES.PORTFOLIO,
  },
];

const description = entry.data.description || getDescription(undefined, entry.body);
const canonicalUrl = `${SITE_URL}/case-studies/${entry.slug}`;
---

<PageLayout
  title={entry.data.title}
  description={description}
  image={entry.data.hero || entry.data.thumbnail}
  type="article"
  canonicalUrl={canonicalUrl}
  breadcrumbs={links}
  frontmatter={entry.data}
>
  <Hero imageUrl={entry.data.hero} />
  <Content
    components={{ ...components, img: Imgmdx, ul: Ulmdx, List: Listmdx }}
  />
</PageLayout>
