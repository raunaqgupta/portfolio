---
const { date } = Astro.props
const format = { year: 'numeric', month: 'long', day: 'numeric' }
const formattedDate = date.toLocaleDateString('en-US', format )
---

<div class="toolbar">
  <div class="break">⎯</div>
  <div class="children">
    <span>{formattedDate}</span>
  </div>
</div>

<style>
  .toolbar {
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-size: 11px;
    font-weight: 100;
    color: #999;
  }

  .break {
    height: 16px;
    color: rgba(175, 175, 175, 0.28);
  }
</style>