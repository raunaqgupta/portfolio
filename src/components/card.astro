---
const { size = "large" } = Astro.props;
---

<article class={`${size}`}>
  <slot />
</article>

<style>
  article {
    display: flex;
    flex-direction: row;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: 10px;
    background: var(--color-bg-1);
  }

  article.small {
    gap: var(--space-2);
    padding: var(--space-1);
    max-height: 150px;
  }

  @media only screen and (max-width: 700px) {
    article.large {
      flex-direction: column;
    }
  }
</style>
