---
import Logo from "@components/logo.astro";
import BaseLayout from "../layouts/baseLayout.astro";
import { ROUTES, SITE_URL } from "../constants";

const description =
  "Personal website of Raunaq Gupta - Design technologist with 10+ years of experience shipping enterprise web applications and developer tools.";
---

<BaseLayout title="Home" description={description} canonicalUrl={SITE_URL}>
  <body>
    <div class="hello">
      <Logo mode="3d" size="large" />
      <div class="content">
        <h1>404</h1>
        <p>
          Go back <a href={ROUTES.HOME}>home</a>.
        </p>
      </div>
    </div>
  </body>
</BaseLayout>

<style>
  body {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: var(--color-bg);
    color: var(--color-body-primary);
    font-family: sans-serif;
    line-height: 28px;
    min-height: 100vh;
    min-height: 100dvh;
    gap: 64px;
    margin: 0 auto;
  }

  .hello {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 64px;
    margin: 0 auto;
  }

  .logo {
    width: 512px;
  }

  .logo img {
    width: 100%;
    height: 100%;
  }

  @media only screen and (max-width: 700px) {
    .logo {
      max-width: 128px;
    }
  }
</style>
