---
// Case studies from one or more organisations as a single row of cards. The
// section pins to the viewport while vertical scrolling moves the row
// sideways, one card at a time; after the last card the page scrolls on.
// The organisation of the centred card is named in outline at the bottom
// left, and changes as the row crosses from one organisation to the next.
// The pinned panel is a BowlCard, so it bends with the grid as it arrives
// and leaves.
//
// Without JavaScript the row is a plain horizontal scroller.
import { getEntry } from "astro:content";
import BowlCard from "./bowlCard.astro";
import { ROUTES } from "../constants";

interface Props {
  /** Ids of "collection" articles, in order; each one's caseStudies are shown. */
  collections: string[];
  /** The grid background's curve. */
  curve?: number;
  /** Accessible name for the section. */
  label?: string;
}

const { collections, curve, label = "Work" } = Astro.props;

const groups = await Promise.all(
  collections.map(async (id) => {
    const entry = await getEntry("articles", id);
    if (!entry) throw new Error(`Showcase: no collection "${id}"`);
    const studies = (
      await Promise.all((entry.data.caseStudies ?? []).map((ref) => getEntry(ref)))
    ).filter((study) => study && study.data.published !== false);
    return { name: entry.data.organization ?? entry.data.title, studies: studies.map((s) => s!) };
  }),
);

const slides = groups.flatMap((group, g) =>
  group.studies.map((study) => ({ group: g, name: group.name, study })),
);
---

<section class="showcase" aria-label={label} style={`--count: ${slides.length};`}>
  <div class="showcase-pin">
    <BowlCard curve={curve} class="showcase-panel">
      <div class="showcase-stage">
        {
          groups.map((group, g) => (
            <p class:list={["wordmark", { "is-current": g === 0 }]} data-group={g} aria-hidden="true">
              {group.name}
            </p>
          ))
        }
        <ol class="track">
          {
            slides.map(({ group, name, study }) => (
              <li class="slide" data-group={group}>
                <a class="slide-link" href={`${ROUTES.PORTFOLIO}/${study.id}`}>
                  <h3 class="slide-title">
                    <span class="visually-hidden">{name}: </span>
                    {study.data.title}
                  </h3>
                  <span class="slide-frame">
                    <img
                      src={study.data.hero ?? study.data.thumbnail}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </BowlCard>
  </div>
</section>

<script>
  // Neighbouring cards shrink to this scale and fade to this opacity, as in
  // the design (680px beside a 769px card, at 50%).
  const SIDE_SCALE = 680 / 769;
  const SIDE_OPACITY = 0.5;
  // Space between a card and its neighbour, in px.
  const GAP = 24;

  const clamp = (v: number, min: number, max: number) =>
    Math.min(max, Math.max(min, v));

  function init(section: HTMLElement) {
    const slides = [...section.querySelectorAll<HTMLElement>(".slide")];
    const wordmarks = [...section.querySelectorAll<HTMLElement>(".wordmark")];
    const stage = section.querySelector<HTMLElement>(".showcase-stage")!;
    const count = slides.length;
    section.classList.add("is-enhanced");
    let frame = 0;

    // How far through the row the scroll is: 0 is the first card centred,
    // count - 1 the last.
    function progress() {
      const rect = section.getBoundingClientRect();
      const travel = rect.height - window.innerHeight;
      if (travel <= 0) return 0;
      return clamp(-rect.top / travel, 0, 1) * (count - 1);
    }

    function update() {
      frame = 0;
      const p = progress();
      const width = slides[0]?.offsetWidth ?? 0;
      // Centre to centre, from a full-size card to a shrunk neighbour.
      const step = width / 2 + GAP + (width * SIDE_SCALE) / 2;
      slides.forEach((slide, i) => {
        const d = i - p;
        const near = Math.min(Math.abs(d), 1);
        const scale = 1 - (1 - SIDE_SCALE) * near;
        slide.style.transform = `translateX(${d * step}px) scale(${scale})`;
        slide.style.setProperty("--slide-opacity", String(1 - (1 - SIDE_OPACITY) * near));
        // The title belongs to the centred card only.
        slide.style.setProperty("--title-opacity", String(clamp(1 - Math.abs(d) * 2, 0, 1)));
        slide.classList.toggle("is-current", Math.abs(d) < 0.5);
      });
      // Name the organisation of the card nearest the centre.
      const group = slides[Math.round(p)]?.dataset.group;
      wordmarks.forEach((mark) =>
        mark.classList.toggle("is-current", mark.dataset.group === group),
      );
    }

    // Each name is as large as fits between the side margins, up to a share
    // of the viewport's height, so short names grow and long ones still fit.
    function sizeWordmarks() {
      const share = parseFloat(getComputedStyle(stage).getPropertyValue("--wordmark-max")) || 1;
      // The margin is a clamp(), so read it resolved, from the left offset.
      const margin = wordmarks[0] ? parseFloat(getComputedStyle(wordmarks[0]).left) : 0;
      const maxHeight = stage.clientHeight * share;
      const room = stage.clientWidth - 2 * margin;
      for (const mark of wordmarks) {
        mark.style.fontSize = "100px";
        const width = mark.scrollWidth;
        if (width) mark.style.fontSize = `${Math.min((room / width) * 100, maxHeight)}px`;
      }
    }

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    // Tabbing to a card scrolls the page to where that card is centred.
    slides.forEach((slide, i) => {
      slide.addEventListener("focusin", () => {
        const travel = section.offsetHeight - window.innerHeight;
        const top = section.getBoundingClientRect().top + window.scrollY;
        const target = top + (count > 1 ? (travel * i) / (count - 1) : 0);
        if (Math.abs(window.scrollY - target) > 1) window.scrollTo({ top: target });
      });
    });

    window.addEventListener("scroll", schedule, { passive: true });
    new ResizeObserver(() => {
      sizeWordmarks();
      schedule();
    }).observe(stage);
    // The names are measured again once the web font has loaded, since a
    // fallback font sets a different width.
    document.fonts?.ready.then(() => {
      sizeWordmarks();
      schedule();
    });
    document.fonts?.addEventListener("loadingdone", sizeWordmarks);
    sizeWordmarks();
    update();
  }

  document.querySelectorAll<HTMLElement>(".showcase").forEach(init);
</script>

<style>
  .showcase {
    /* Sized from the design's 1231 × 800 frame: a 769 × 577 card. */
    --card-w: min(62.5vw, 96vh, 769px);
    --card-h: calc(var(--card-w) * 577 / 769);
    position: relative;
  }

  /* Each card after the first adds this much scrolling. */
  .showcase.is-enhanced {
    height: calc(100vh + (var(--count) - 1) * 60vh);
  }

  .showcase-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .showcase-pin > :global(.showcase-panel) {
    flex: 1;
  }

  .showcase-stage {
    position: relative;
    flex: 1;
  }

  /* The organisation's name, outlined, pinned to the bottom-left corner of
     the viewport. Script sets its size; this is the fallback. */
  .showcase-stage {
    --wordmark-margin: clamp(16px, 9vw, 96px);
    /* Largest font size, as a share of the viewport's height. */
    --wordmark-max: 0.24;
  }

  .wordmark {
    position: absolute;
    z-index: 2;
    left: var(--wordmark-margin);
    bottom: var(--wordmark-margin);
    margin: 0;
    font-family: var(--font-inter), "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 12vw;
    font-weight: 900;
    /* About Inter's cap height, so the box hugs the capitals and the margin
       is measured from the letters themselves. */
    line-height: 0.73;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-heading);
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease-out;
  }

  .wordmark.is-current {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark {
      transition: none;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .track {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Without JavaScript: a row that scrolls sideways. */
  .showcase:not(.is-enhanced) .track {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 calc(50% - var(--card-w) / 2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .showcase:not(.is-enhanced) .slide {
    flex: none;
    scroll-snap-align: center;
  }

  /* With JavaScript every card sits at the centre and is moved from there. */
  .is-enhanced .slide {
    position: absolute;
    left: calc(50% - var(--card-w) / 2);
    top: calc(50% - var(--card-h) / 2);
    transform-origin: 50% 50%;
  }

  .slide {
    width: var(--card-w);
    height: var(--card-h);
  }

  .slide-link {
    display: block;
    height: 100%;
    color: inherit;
    background: none;
  }

  .slide-link:hover,
  .slide-link:focus {
    background: none;
  }

  .slide-title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 12px);
    margin: 0;
    font-family: var(--font-inter), "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 24px;
    font-weight: 900;
    line-height: 1.2;
    text-align: center;
    color: var(--color-body-primary);
    opacity: var(--title-opacity, 1);
  }

  .slide-frame {
    box-sizing: border-box;
    display: block;
    height: 100%;
    padding: 24px;
    border: 1px solid var(--color-heading);
    opacity: var(--slide-opacity, 1);
    transition: border-color 150ms;
  }

  .slide-link:hover .slide-frame,
  .slide-link:focus-visible .slide-frame {
    border-color: var(--color-highlight);
  }

  .slide-link:focus-visible {
    outline: none;
  }

  .slide-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: var(--color-bg-1);
  }

  /* Off-centre cards aren't links you can click by accident. */
  .is-enhanced .slide:not(.is-current) {
    pointer-events: none;
  }

  @media only screen and (max-width: 700px) {
    .showcase {
      --card-w: min(84vw, 96vh);
    }

    .slide-title {
      font-size: 18px;
    }

    .slide-frame {
      padding: 12px;
    }
  }
</style>
