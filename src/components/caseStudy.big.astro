---
const {
  image,
  name,
  title,
  description,
  url,
  caseStudyCount = 0,
} = Astro.props;
---

<a href={url}>
  <article>
    <div class="text">
      {
        name && (
          <div class="name">
            <span>{name}</span>
            <span aria-hidden="true">·</span>
            <span>
              {caseStudyCount} case stud{caseStudyCount !== 1 ? "ies" : "y"}
            </span>
          </div>
        )
      }
      <p class="title">{title}</p>
      <p class="description">{description}</p>
    </div>
    <div class="image" style={`--img: url("${image}")`}></div>
  </article>
</a>

<style>
  a {
    border-radius: 6px;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
    display: block;
    text-decoration: none;
    transition: transform 160ms ease;
  }

  a:after {
    content: none;
  }

  a:hover {
    transform: translateY(-4px);
  }

  a:hover .image {
    transform: translateY(-16px);
  }

  article {
    border: 1px solid var(--color-border-bg);
    border-radius: 6px;
    backdrop-filter: blur(10px) saturate(130%);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    justify-content: space-between;
    height: 100%;
    background-image: linear-gradient(
        var(--color-border-bg) 1px,
        transparent 1px
      ),
      linear-gradient(90deg, var(--color-border-bg) 1px, transparent 1px);
    background-size: 20px 20px;
    background-position: -4px -4px;

    -webkit-mask-image: linear-gradient(
      180deg,
      rgba(0, 0, 0, 1) 50%,
      rgba(255, 255, 255, 1) 95%
    );
    mask-image: linear-gradient(
      180deg,
      rgba(0, 0, 0, 1) 50%,
      rgba(255, 255, 255, 0) 95%
    );
  }

  .text {
    padding: var(--space-2);
  }

  .name {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.6em;
    font-weight: 500;
    color: var(--color-body-tertiary);
    text-transform: uppercase;
    line-height: 1;
    border: 1px solid #eee;
    padding: var(--space-0) var(--space-1);
    border-radius: 6px;
  }

  .image {
    background-image: var(--img);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    height: 300px;
    transition: transform 160ms ease;
  }

  .image img {
    width: 100%;
    object-fit: fill;
    display: block;
  }

  p.title {
    margin: 0;
    font-size: 1em;
    font-weight: 600;
    color: var(--color-heading);
  }

  p.description {
    margin: 0;
    font-size: 0.9em;
    line-height: 1.3em;
    color: var(--color-body-secondary);
  }

  @media only screen and (max-width: 700px) {
    .image {
      background-size: contain;
      background-position: top;
      height: 200px;
      margin-inline: var(--space-2);
    }
  }

  @media (prefers-color-scheme: dark) {
    a {
      box-shadow: rgba(0, 0, 0, 0.1) 4px 4px 29px;
    }

    .text {
      color: var(--color-body-primary);
    }
  }
</style>
