---
import WideLayout from "../../layouts/WideLayout.astro";
import Imgmdx from "@components/img.mdx.astro";
import Hero from "@components/hero.astro";

import { getCollection, render } from "astro:content";
import { SITE_URL } from "../../constants";
import { getDescription } from "../../utils";

export async function getStaticPaths() {
  try {
    const products = await getCollection("articles", ({ data }) => {
      return data.category === "collection";
    });
    return products.map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
  } catch (error) {
    console.error("Error generating collection paths:", error);
    return [];
  }
}

const { entry } = Astro.props;

if (!entry) {
  return Astro.redirect("/404");
}

const { Content } = await render(entry);

const description =
  entry.data.description || getDescription(undefined, entry.body);
const canonicalUrl = `${SITE_URL}/collection/${entry.id}`;
---

<WideLayout
  title={entry.data.title}
  description={description}
  image={entry.data.hero || entry.data.thumbnail}
  canonicalUrl={canonicalUrl}
  frontmatter={entry.data}
>
  <Hero imageUrl={entry.data.hero} aspectRatio={1.5} />
  <Content components={{ img: Imgmdx }} />
</WideLayout>
